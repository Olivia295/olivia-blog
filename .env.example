# Optional explicit content source. Relative paths are resolved from the website directory.
# CONTENT_DIR=../my-content
# CONTENT_MODE=sample
# CONTENT_REPO=git@github.com:your-name/your-private-content.git
# Set read-only CONTENT_SSH_KEY or CONTENT_REPO_TOKEN in deployment secrets, never here.
# CONTENT_LEGACY=1

# Optional media CDN. Leave unset when using local/sample images.
# PUBLIC_MEDIA_BASE_URL=https://your-media.example.com

# Optional Webmentions integration.
# WEBMENTION_URL=https://webmention.io/your-domain/webmention
# WEBMENTION_PINGBACK=https://webmention.io/your-domain/xmlrpc
# WEBMENTION_API_KEY=
