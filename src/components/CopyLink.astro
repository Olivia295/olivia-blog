---
import type { Lang } from "@/i18n/config";

interface Props {
	url: string;
	label?: string;
	lang: Lang;
}
const { url, lang, label = lang === "zh" ? "复制链接" : "Copy link" } = Astro.props;
---

<div
	class="copy-link"
	data-copy-url={url}
	data-success={lang === "zh" ? "链接已复制" : "Link copied"}
	data-success-label={lang === "zh" ? "已复制" : "Copied"}
	data-failure={lang === "zh"
		? "无法自动复制，请选中下方地址复制。"
		: "Select the address below to copy it."}
>
	<button class="paper-action copy-trigger" type="button" data-copy-button hidden>
		<svg
			class="paper-action__icon"
			width="18"
			height="18"
			viewBox="0 0 20 20"
			fill="none"
			stroke="currentColor"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			<g class="copy-link__icon"
				><rect x="6.5" y="6.5" width="10" height="11" rx="1.5"></rect><path
					d="M12.5 3.5v-1h-10v11h1"></path></g
			>
			<path class="copy-link__check" d="m4 10 4 4 8-9"></path>
		</svg>
		<span class="action-label" data-copy-label>{label}</span>
	</button>
	<span class="copy-link__status sr-only" role="status" aria-live="polite"></span>
	<label class="copy-link__fallback" hidden>
		<span>{lang === "zh" ? "链接地址" : "Link address"}</span>
		<input type="text" value={url} readonly />
	</label>
	<noscript><a href={url}>{url}</a></noscript>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-copy-url]")) {
		const button = root.querySelector<HTMLButtonElement>("[data-copy-button]")!;
		const status = root.querySelector<HTMLElement>("[role='status']")!;
		const fallback = root.querySelector<HTMLLabelElement>(".copy-link__fallback")!;
		const input = fallback.querySelector<HTMLInputElement>("input")!;
		const label = button.querySelector<HTMLElement>("[data-copy-label]")!;
		const originalLabel = label.textContent || "";
		let resetTimer: number | undefined;
		let pending = false;
		const resetButton = () => {
			delete button.dataset.copied;
			label.textContent = originalLabel;
		};
		button.hidden = false;
		button.addEventListener("click", async () => {
			if (pending) return;
			pending = true;
			window.clearTimeout(resetTimer);
			resetButton();
			button.setAttribute("aria-busy", "true");
			button.setAttribute("aria-disabled", "true");
			status.textContent = "";
			status.classList.add("sr-only");
			try {
				await navigator.clipboard.writeText(root.dataset.copyUrl!);
				fallback.hidden = true;
				button.dataset.copied = "true";
				label.textContent = root.dataset.successLabel!;
				status.textContent = root.dataset.success!;
				resetTimer = window.setTimeout(resetButton, 2000);
			} catch {
				fallback.hidden = false;
				status.classList.remove("sr-only");
				input.focus();
				input.select();
				status.textContent = root.dataset.failure!;
			} finally {
				pending = false;
				button.removeAttribute("aria-busy");
				button.removeAttribute("aria-disabled");
			}
		});
	}
</script>

<style>
	.copy-link {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		min-width: 0;
	}
	button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0.45rem 0.6rem;
		color: var(--color-brand);
		text-decoration: none;
		font: inherit;
	}
	.paper-action__icon {
		flex: none;
	}
	.copy-link__check,
	[data-copied="true"] .copy-link__icon {
		display: none;
	}
	[data-copied="true"] .copy-link__check {
		display: block;
	}
	.copy-link__status:not(.sr-only) {
		flex-basis: 100%;
		font-size: 0.85rem;
	}
	.copy-link__fallback {
		flex-basis: 100%;
		min-width: 0;
		font-size: 0.85rem;
	}
	input {
		display: block;
		width: 100%;
		min-height: 44px;
		padding: 0.5rem;
		margin-top: 0.35rem;
		border: 1px solid currentColor;
		border-radius: var(--skin-focus-radius);
		background: var(--color-global-bg);
		color: var(--color-global-text);
	}
	[hidden] {
		display: none !important;
	}
</style>
