---
/**
 * Viewport-fixed "back to top". Appears after scrolling down.
 * Reparented to document.body so layout animations cannot trap `position: fixed`.
 */
import { defaultLang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const label = t("backToTop");
---

<button
	id="floating-back"
	class="floating-back"
	type="button"
	data-show="false"
	aria-label={label}
	title={label}
>
	<svg
		aria-hidden="true"
		class="floating-back__icon"
		fill="none"
		focusable="false"
		stroke="currentColor"
		stroke-width="2"
		viewBox="0 0 24 24"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path d="M4.5 15.75 12 8.25l7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
	<span class="floating-back__label">{label}</span>
</button>

<script>
	const btn = document.getElementById("floating-back");
	if (btn) {
		if (btn.parentElement !== document.body) {
			document.body.appendChild(btn);
		}

		const threshold = 280;
		const scroller = document.querySelector(".page-scroll");
		const y = () => (scroller ? scroller.scrollTop : window.scrollY);
		const update = () => {
			btn.dataset.show = (y() > threshold).toString();
		};

		update();
		(scroller ?? window).addEventListener("scroll", update, { passive: true });
		btn.addEventListener("click", () => {
			(scroller ?? window).scrollTo({ top: 0, behavior: "smooth" });
		});
	}
</script>

<style>
	.floating-back {
		position: fixed;
		right: max(0.85rem, env(safe-area-inset-right));
		bottom: max(1.25rem, calc(0.85rem + env(safe-area-inset-bottom)));
		z-index: 80;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid color-mix(in oklch, var(--color-global-text) 10%, transparent);
		background: color-mix(in oklch, var(--color-global-bg) 88%, white);
		box-shadow: 0 8px 24px color-mix(in oklch, var(--color-global-text) 12%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: inherit;
		cursor: pointer;
		font-size: 0.8rem;
		font-weight: 600;
		font-family: inherit;
		line-height: 1.2;
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.75rem);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease,
			box-shadow 0.2s ease;
	}

	.floating-back__label {
		display: none;
	}

	@media (min-width: 640px) {
		.floating-back {
			right: max(1.5rem, env(safe-area-inset-right));
			bottom: max(1.5rem, calc(1rem + env(safe-area-inset-bottom)));
			width: auto;
			height: auto;
			min-height: 2.65rem;
			padding: 0.5rem 0.95rem 0.5rem 0.7rem;
			justify-content: flex-start;
		}

		.floating-back__label {
			display: inline;
		}
	}

	.floating-back:hover {
		box-shadow: 0 10px 28px color-mix(in oklch, var(--color-brand) 16%, transparent);
	}

	.floating-back[data-show="true"] {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.floating-back__icon {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-back {
			transition: opacity 0.15s ease;
			transform: none;
		}
	}
</style>
