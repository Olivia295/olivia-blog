---
/**
 * Viewport-fixed "back to top". Appears after scrolling down.
 * Reparented to document.body so layout animations cannot trap `position: fixed`.
 */
import { defaultLang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const label = t("backToTop");
---

<button
	id="floating-back"
	class="floating-back"
	type="button"
	data-show="false"
	aria-label={label}
	title={label}
>
	<svg
		aria-hidden="true"
		class="floating-back__icon"
		fill="none"
		focusable="false"
		stroke="currentColor"
		stroke-width="2"
		viewBox="0 0 24 24"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path d="M4.5 15.75 12 8.25l7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
	<span class="floating-back__label">{label}</span>
</button>

<script>
	const btn = document.getElementById("floating-back");
	if (btn) {
		if (btn.parentElement !== document.body) {
			document.body.appendChild(btn);
		}

		const threshold = 280;
		const y = () => window.scrollY;
		const update = () => {
			btn.dataset.show = (y() > threshold).toString();
			btn.tabIndex = y() > threshold ? 0 : -1;
		};

		update();
		window.addEventListener("scroll", update, { passive: true });
		btn.addEventListener("click", () => {
			window.scrollTo({
				top: 0,
				behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
			});
			document.getElementById("main")?.focus({ preventScroll: true });
		});
	}
</script>

<style>
	.floating-back {
		position: fixed;
		right: max(0.85rem, env(safe-area-inset-right));
		bottom: max(1.25rem, calc(0.85rem + env(safe-area-inset-bottom)));
		z-index: 80;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		cursor: pointer;
		pointer-events: none;
		transform: translateY(0.75rem);
	}

	.floating-back__label {
		display: none;
	}

	@media (min-width: 640px) {
		.floating-back {
			right: max(1.5rem, env(safe-area-inset-right));
			bottom: max(1.5rem, calc(1rem + env(safe-area-inset-bottom)));
			width: auto;
			height: auto;
			min-height: 2.65rem;
			padding: 0.5rem 0.95rem 0.5rem 0.7rem;
			justify-content: flex-start;
		}

		.floating-back__label {
			display: inline;
		}
	}

	.floating-back[data-show="true"] {
		pointer-events: auto;
		transform: translateY(0);
	}

	.floating-back__icon {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-back {
			transform: none;
		}
	}
</style>
