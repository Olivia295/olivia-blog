---
import type { HTMLAttributes } from "astro/types";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl } from "@/i18n/utils";
import { getFormattedDate } from "@/utils/date";

type Props = HTMLAttributes<"time"> & {
	date: Date;
	dateTimeOptions?: Intl.DateTimeFormatOptions;
	lang?: Lang;
	omitYear?: boolean;
};

const { date, dateTimeOptions, lang: langProp, omitYear = false, ...attrs } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;

const postDate = getFormattedDate(
	date,
	omitYear ? { ...dateTimeOptions, year: undefined } : dateTimeOptions,
	lang,
);
const ISO = date.toISOString();
---

<time datetime={ISO} title={ISO} {...attrs}>{postDate}</time>
