---
import { type Lang, languageLabels, languages } from "@/i18n/config";
import { switchLocalePath } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
---

<div class="lang-switch" role="group" aria-label={lang === "zh" ? "切换语言" : "Switch language"}>
	{
		languages.map((code) => {
			const href = switchLocalePath(pathname, code);
			const active = code === lang;
			return (
				<a
					href={href}
					class:list={["lang-link", { active }]}
					aria-current={active ? "page" : undefined}
					hreflang={code}
					data-set-locale={code}
				>
					{languageLabels[code]}
				</a>
			);
		})
	}
</div>

<script>
	document.querySelectorAll<HTMLAnchorElement>("[data-set-locale]").forEach((link) => {
		link.addEventListener("click", () => {
			const locale = link.dataset.setLocale;
			if (!locale) return;
			// Read at activation time: the series filter can change without navigation.
			const target = new URL(link.href);
			target.search = window.location.search;
			target.hash = window.location.hash;
			link.href = target.href;
			// 1 year
			document.cookie = `locale=${locale}; path=/; max-age=31536000; samesite=lax`;
		});
	});
</script>

<style>
	.lang-switch {
		display: inline-flex;
		gap: 0;
		align-items: center;
	}
	.lang-link {
		min-width: 32px;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.lang-link.active {
		text-underline-offset: 5px;
	}
</style>
