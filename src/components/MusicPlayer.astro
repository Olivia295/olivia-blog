---
import { getSongs, type Song } from "@/data/music";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

/**
 * Page-scoped player only. Do not mount in Base layout —
 * multi-page navigations remount the document and kill <audio>.
 */
interface Props {
	songs?: Song[];
	lang?: Lang;
}

const { songs: songsProp, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const songs = songsProp ?? getSongs();
const hasSongs = songs.length > 0;
const singleTrack = songs.length === 1;
const displayTitle =
	songs[0]?.title && !/^bgm$/i.test(songs[0].title) ? songs[0].title : t("music.trackForBlog");
const displayArtist = songs[0]?.artist && songs[0].artist !== "Unknown Artist" ? songs[0].artist : "";
---

{
	hasSongs ? (
		<div id="music-player" class="music-player" data-single={singleTrack ? "true" : "false"}>
			<div class="music-player__mark" aria-hidden="true">
				{t("music.trackForBlog")}
			</div>
			<div class="now-playing">
				<p id="current-title" class="current-title">
					{displayTitle}
				</p>
				{
					displayArtist && (
						<p id="current-artist" class="current-artist">
							{displayArtist}
						</p>
					)
				}
			</div>

			<audio id="audio-player" controls preload="metadata">
				<source id="audio-source" src={songs[0]?.src} type="audio/mpeg" />
			</audio>

			{
				!singleTrack && (
					<ul class="playlist" role="list">
						{songs.map((song, index) => (
							<li>
								<button
									type="button"
									class={index === 0 ? "active" : ""}
									data-index={index}
									data-src={song.src}
									data-title={song.title}
									data-artist={song.artist}
								>
									<span class="song-title">{song.title}</span>
									<span class="song-artist">{song.artist}</span>
								</button>
							</li>
						))}
					</ul>
				)
			}
		</div>
	) : null
}

<script>
	const root = document.getElementById("music-player");
	if (root && root.dataset.single !== "true") {
		const audio = document.getElementById("audio-player") as HTMLAudioElement;
		const source = document.getElementById("audio-source") as HTMLSourceElement;
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".playlist button"));
		const currentTitle = document.getElementById("current-title") as HTMLParagraphElement;
		const currentArtist = document.getElementById("current-artist") as HTMLParagraphElement;

		let currentIndex = 0;

		function playSong(index: number) {
			const button = buttons[index];
			if (!button) return;

			const src = button.dataset.src;
			const title = button.dataset.title;
			const artist = button.dataset.artist;
			if (!src) return;

			currentIndex = index;
			source.src = src;
			audio.load();
			void audio.play().catch(() => {});

			if (title) currentTitle.textContent = title;
			if (artist && currentArtist) currentArtist.textContent = artist;

			buttons.forEach((btn) => btn.classList.remove("active"));
			button.classList.add("active");
		}

		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				playSong(Number(button.dataset.index));
			});
		});

		audio.addEventListener("ended", () => {
			const nextIndex = (currentIndex + 1) % buttons.length;
			playSong(nextIndex);
		});
	}
</script>

<style>
	.music-player {
		position: relative;
		width: min(22rem, 100%);
		margin-inline: auto;
		padding: 1.1rem 1.2rem 1.15rem;
		border-radius: 1.05rem;
		background: color-mix(in oklch, var(--color-brand) 9%, var(--color-global-bg));
		border: 1px solid color-mix(in oklch, var(--color-brand) 38%, transparent);
		box-shadow:
			inset 0 1px 0 color-mix(in oklch, white 35%, transparent),
			0 10px 28px color-mix(in oklch, var(--color-brand) 12%, transparent);
	}

	.music-player__mark {
		position: absolute;
		top: -0.55rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.12rem 0.55rem;
		border-radius: 999px;
		background: var(--color-brand);
		color: white;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.2;
	}

	.now-playing {
		margin: 0.35rem 0 0.85rem;
		text-align: center;
	}

	.label {
		margin: 0 0 0.3rem;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: var(--color-brand);
	}

	.current-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.current-artist {
		margin: 0.2rem 0 0;
		font-size: 0.8rem;
		opacity: 0.65;
	}

	audio {
		width: 100%;
		height: 2.35rem;
		accent-color: var(--color-brand);
	}

	.playlist {
		list-style: none;
		padding: 0;
		margin: 0.9rem 0 0;
		max-height: 20rem;
		overflow-y: auto;
	}

	.playlist li {
		margin-bottom: 0.3rem;
	}

	.playlist button {
		width: 100%;
		border: none;
		background: transparent;
		padding: 0.65rem 0.75rem;
		border-radius: 0.65rem;
		cursor: pointer;
		text-align: left;
		font-family: inherit;
		color: inherit;
		transition: background 0.15s ease;
	}

	.playlist button:hover,
	.playlist button.active {
		background: color-mix(in oklch, var(--color-brand) 12%, transparent);
	}

	.playlist button.active {
		box-shadow: inset 2px 0 0 var(--color-brand);
	}

	.song-title {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.song-artist {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		opacity: 0.6;
	}
</style>
