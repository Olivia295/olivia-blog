---
import type { PaginationLink } from "@/types";

interface PageLink {
	href: string;
	number: number;
	current: boolean;
}

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
	pages?: PageLink[];
}

const { nextUrl, prevUrl, pages = [] } = Astro.props;
---

{
	(pages.length > 0 || prevUrl || nextUrl) && (
		<nav class="pager" aria-label="Pagination">
			{prevUrl ? (
				<a class="pager__arrow" href={prevUrl.url} aria-label={prevUrl.text}>
					←
				</a>
			) : (
				<span class="pager__arrow pager__arrow--off" aria-hidden="true">
					←
				</span>
			)}
			{pages.map((item) =>
				item.current ? (
					<span class="pager__dot pager__dot--now" aria-current="page">
						{item.number}
					</span>
				) : (
					<a class="pager__dot" href={item.href}>
						{item.number}
					</a>
				),
			)}
			{nextUrl ? (
				<a class="pager__arrow" href={nextUrl.url} aria-label={nextUrl.text}>
					→
				</a>
			) : (
				<span class="pager__arrow pager__arrow--off" aria-hidden="true">
					→
				</span>
			)}
		</nav>
	)
}

<style>
	.pager {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		margin-top: 2.25rem;
	}

	.pager__arrow,
	.pager__dot {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		height: 2rem;
		padding: 0 0.4rem;
	}

	.pager__arrow--off {
		pointer-events: none;
	}
</style>
