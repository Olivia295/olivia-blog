---
import type { PaginationLink } from "@/types";

interface PageLink {
	href: string;
	number: number;
	current: boolean;
}

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
	pages?: PageLink[];
}

const { nextUrl, prevUrl, pages = [] } = Astro.props;
---

{
	(pages.length > 0 || prevUrl || nextUrl) && (
		<nav class="pager" aria-label="Pagination">
			{prevUrl ? (
				<a class="pager__arrow" href={prevUrl.url} aria-label={prevUrl.text}>
					←
				</a>
			) : (
				<span class="pager__arrow pager__arrow--off" aria-hidden="true">
					←
				</span>
			)}
			{
				pages.map((item) =>
					item.current ? (
						<span class="pager__dot pager__dot--now" aria-current="page">
							{item.number}
						</span>
					) : (
						<a class="pager__dot" href={item.href}>
							{item.number}
						</a>
					),
				)
			}
			{nextUrl ? (
				<a class="pager__arrow" href={nextUrl.url} aria-label={nextUrl.text}>
					→
				</a>
			) : (
				<span class="pager__arrow pager__arrow--off" aria-hidden="true">
					→
				</span>
			)}
		</nav>
	)
}

<style>
	.pager {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		margin-top: 2.25rem;
	}

	.pager__arrow,
	.pager__dot {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		height: 2rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
		opacity: 0.55;
		transition:
			opacity 0.15s ease,
			background 0.15s ease,
			color 0.15s ease;
	}

	.pager__arrow:hover,
	.pager__dot:hover {
		opacity: 1;
		background: color-mix(in oklch, var(--color-global-text) 6%, transparent);
	}

	.pager__dot--now {
		opacity: 1;
		color: var(--color-brand);
		background: color-mix(in oklch, var(--color-brand) 12%, transparent);
	}

	.pager__arrow--off {
		opacity: 0.18;
		pointer-events: none;
	}
</style>
