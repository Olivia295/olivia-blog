---
import type { PaginationLink } from "@/types";

interface PageLink {
	href: string;
	number: number;
	current: boolean;
}

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
	pages?: PageLink[];
}

const { nextUrl, prevUrl, pages = [] } = Astro.props;
const show = Boolean(prevUrl || nextUrl || pages.length > 1);
---

{
	show && (
		<nav class="pager" aria-label="Pagination">
			{prevUrl ? (
				<a class="pager__step" href={prevUrl.url}>
					{prevUrl.text}
				</a>
			) : (
				<span class="pager__step pager__step--ghost" />
			)}
			{
				pages.length > 1 && (
					<ol class="pager__pages">
						{pages.map((item) => (
							<li>
								{item.current ? (
									<span class="pager__num pager__num--current" aria-current="page">
										{item.number}
									</span>
								) : (
									<a class="pager__num" href={item.href}>
										{item.number}
									</a>
								)}
							</li>
						))}
					</ol>
				)
			}
			{nextUrl ? (
				<a class="pager__step pager__step--next" href={nextUrl.url}>
					{nextUrl.text}
				</a>
			) : (
				<span class="pager__step pager__step--next pager__step--ghost" />
			)}
		</nav>
	)
}

<style>
	.pager {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 10%, transparent);
	}

	.pager__pages {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.pager__num,
	.pager__step {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.15rem 0.55rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
	}

	.pager__num--current {
		color: var(--color-brand);
		box-shadow: inset 0 -2px 0 var(--color-brand);
	}

	.pager__step:hover,
	.pager__num:hover {
		color: var(--color-brand);
	}

	.pager__step--ghost {
		visibility: hidden;
		min-width: 4.5rem;
	}

	.pager__step--next {
		margin-inline-start: auto;
	}
</style>
