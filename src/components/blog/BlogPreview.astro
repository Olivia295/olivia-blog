---
import type { CollectionEntry } from "astro:content";
import SeriesPath from "@/components/blog/SeriesPath.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, localePath } from "@/i18n/utils";

interface Props {
	post: CollectionEntry<"blog">;
	lang?: Lang;
	omitYear?: boolean;
}

const { post, lang: langProp, omitYear = false } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const { title, description, publishDate, draft, series = [] } = post.data;
// Placeholder summaries such as "//" are left out.
const summary = /[\p{L}\p{N}]/u.test(description ?? "") ? description : "";
---

<article class="grid gap-x-5 gap-y-1 py-4 sm:grid-cols-[5.5rem_minmax(0,1fr)]">
	<FormattedDate
		class="text-muted text-sm font-semibold"
		date={publishDate}
		lang={lang}
		omitYear={omitYear}
	/>
	<div class="min-w-0">
		<h3 class="font-semibold">
			{draft && <span class="draft-label">(Draft) </span>}
			<a class="cactus-link" href={localePath(lang, `/blogs/${post.id}/`)}>{title}</a>
		</h3>
		{summary && <p class="text-muted mt-1 line-clamp-2 text-sm">{summary}</p>}
		<SeriesPath series={series} lang={lang} class="mt-1.5 text-sm" />
	</div>
</article>
