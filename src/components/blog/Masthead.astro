---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { seriesHref, seriesLabel } from "@/data/site-series";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
	content: CollectionEntry<"blog">;
	/** Whole minutes, from remark plugin */
	readingTimeMinutes: number;
	lang?: Lang;
}

const {
	content: { data },
	readingTimeMinutes,
	lang: langProp,
} = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const readingTimeLabel = t("blog.readingTime", { n: readingTimeMinutes });

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

{
	data.coverImage && (
		<div class="mb-6 aspect-video">
			<Image
				alt={data.coverImage.alt}
				layout="constrained"
				width={748}
				height={420}
				priority
				src={data.coverImage.src}
			/>
		</div>
	)
}
{data.draft ? <span class="draft-label text-base">({t("blog.draft")})</span> : null}
<h1 class="title">
	{data.title}
</h1>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
	<p class="font-semibold">
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} lang={lang} /> /{" "}
		{readingTimeLabel}
	</p>
	{
		data.updatedDate && (
			<span class="post-badge px-2 py-1">
				{t("blog.updated")}:
				<FormattedDate
					class="ms-1"
					date={data.updatedDate}
					dateTimeOptions={dateTimeOptions}
					lang={lang}
				/>
			</span>
		)
	}
</div>
{
	data.series.length > 0 && (
		<p class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
			{data.series.map((name) => (
				<a class="cactus-link" href={seriesHref(name, lang)}>
					{seriesLabel(name, lang)}
				</a>
			))}
		</p>
	)
}
