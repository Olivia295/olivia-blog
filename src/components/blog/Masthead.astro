---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import SeriesPath from "@/components/blog/SeriesPath.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
	content: CollectionEntry<"blog">;
	/** Whole minutes, from remark plugin */
	readingTimeMinutes: number;
	lang?: Lang;
}

const {
	content: { data },
	readingTimeMinutes,
	lang: langProp,
} = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const readingTimeLabel = t("blog.readingTime", { n: readingTimeMinutes });

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

{
	data.coverImage && (
		<div class="mb-6 aspect-video">
			<Image
				alt={data.coverImage.alt}
				layout="constrained"
				width={748}
				height={420}
				priority
				src={data.coverImage.src}
			/>
		</div>
	)
}
{data.draft ? <span class="draft-label text-base">({t("blog.draft")})</span> : null}
<h1 class="title">
	{data.title}
</h1>
<div class="article-meta">
	<p class="article-meta__details font-semibold">
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} lang={lang} /> /{" "}
		{readingTimeLabel}
	</p>
	{
		data.updatedDate && (
			<span class="post-badge px-2 py-1">
				{t("blog.updated")}:
				<FormattedDate
					class="ms-1"
					date={data.updatedDate}
					dateTimeOptions={dateTimeOptions}
					lang={lang}
				/>
			</span>
		)
	}
	{
		Astro.slots.has("actions") && (
			<div class="article-meta__actions" data-pagefind-ignore>
				<slot name="actions" />
			</div>
		)
	}
</div>
<SeriesPath series={data.series} lang={lang} class="mt-2" />
