---
import type { MarkdownHeading } from "astro";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
	lang?: Lang;
}

const { headings, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const toc = generateToc(headings);
---

<details class="article-toc">
	<summary>{t("blog.toc")}</summary>
	<nav aria-label={t("blog.toc")}>
		<ol>{toc.map((heading) => <TOCHeading heading={heading} />)}</ol>
	</nav>
</details>
<script>
	const toc = document.querySelector<HTMLDetailsElement>(".article-toc");
	if (toc && matchMedia("(min-width: 801px)").matches) toc.open = true;
</script>
