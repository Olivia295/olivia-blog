---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class="article-toc__item" data-heading-level={depth}>
	<a class="article-toc__link" href={`#${slug}`}>{text}</a>
	{
		!!children.length && (
			<ol class="article-toc__list">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
