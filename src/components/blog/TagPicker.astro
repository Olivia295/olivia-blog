---
import { getAllBlogs, getSeriesWithCount } from "@/data/blog";
import { seriesHref, seriesPath } from "@/data/site-series";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
	current?: string;
}

const { lang, current } = Astro.props;
const t = useTranslations(lang);
const tags = getSeriesWithCount(await getAllBlogs());
---

{
	tags.length > 0 && (
		<>
			<button type="button" class="tag-more" onclick="this.nextElementSibling.showModal()">
				{t("blogs.series")}
				<span aria-hidden="true"> →</span>
			</button>
			<dialog class="tag-picker" data-tag-picker aria-labelledby="tag-picker-title">
				<div class="tag-picker__panel">
					<header class="tag-picker__head">
						<h2 id="tag-picker-title" class="tag-picker__title">
							{t("blogs.series")}
						</h2>
						<button
							type="button"
							class="tag-picker__close"
							aria-label={t("tags.close")}
							onclick="this.closest('dialog').close()"
						>
							×
						</button>
					</header>
					<ul class="tag-picker__list" role="list">
						{tags.map(([tag, count]) => (
							<li>
								<a
									class:list={["tag-picker__link", { "is-current": current === tag }]}
									href={seriesHref(tag, lang)}
								>
									<span>
										{seriesPath(tag)
											.map((entry) => entry[lang])
											.join(" / ")}
									</span>
									<span class="tag-picker__count">
										{count} {t("tags.count")}
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</dialog>
		</>
	)
}

<script>
	document.querySelectorAll<HTMLDialogElement>("[data-tag-picker]").forEach((dialog) => {
		dialog.addEventListener("click", (click) => {
			if (click.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.tag-more {
		margin-top: 1rem;
		padding: 0;
		cursor: pointer;
	}

	.tag-picker {
		width: min(28rem, calc(100vw - 2rem));
		max-height: min(70vh, 32rem);
		margin: auto;
		padding: 0;
	}

	.tag-picker__panel {
		display: flex;
		flex-direction: column;
		max-height: min(70vh, 32rem);
	}

	.tag-picker__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.1rem 0.75rem;
	}

	.tag-picker__title {
		margin: 0;
	}

	.tag-picker__close {
		width: 2rem;
		height: 2rem;
		padding: 0;
		cursor: pointer;
	}

	.tag-picker__list {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		padding: 0.6rem 0.55rem 0.75rem;
		overflow: auto;
		list-style: none;
	}

	.tag-picker__link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.45rem 0.55rem;
	}
</style>
