---
import { getAllBlogs, getUniqueTagsWithCount } from "@/data/blog";
import type { Lang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";

interface Props {
	lang: Lang;
	current?: string;
}

const { lang, current } = Astro.props;
const t = useTranslations(lang);
const tags = getUniqueTagsWithCount(await getAllBlogs());
---

{
	tags.length > 0 && (
		<>
			<button type="button" class="tag-more" onclick="this.nextElementSibling.showModal()">
				{t("tags.more")}
				<span aria-hidden="true"> →</span>
			</button>
			<dialog class="tag-picker" data-tag-picker aria-labelledby="tag-picker-title">
				<div class="tag-picker__panel">
					<header class="tag-picker__head">
						<h2 id="tag-picker-title" class="tag-picker__title">
							{t("tags.pick")}
						</h2>
						<button type="button" class="tag-picker__close" aria-label={t("tags.close")} onclick="this.closest('dialog').close()">
							×
						</button>
					</header>
					<ul class="tag-picker__list" role="list">
						{tags.map(([tag, count]) => (
							<li>
								<a
									class:list={["tag-picker__link", { "is-current": current === tag }]}
									href={localePath(lang, `/blogs/tags/${tag}/`)}
								>
									<span>#{tag}</span>
									<span class="tag-picker__count">
										{count} {t("tags.count")}
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</dialog>
		</>
	)
}

<script>
	document.querySelectorAll<HTMLDialogElement>("[data-tag-picker]").forEach((dialog) => {
		dialog.addEventListener("click", (click) => {
			if (click.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.tag-more {
		margin-top: 1rem;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		font: inherit;
		font-weight: 600;
	}

	.tag-more:hover {
		color: var(--color-accent);
	}

	.tag-picker {
		width: min(28rem, calc(100vw - 2rem));
		max-height: min(70vh, 32rem);
		margin: auto;
		padding: 0;
		border: 1px solid color-mix(in oklch, var(--color-global-text) 12%, transparent);
		border-radius: 1rem;
		background: var(--color-global-bg);
		color: inherit;
		box-shadow: 0 18px 48px color-mix(in oklch, black 16%, transparent);
	}

	.tag-picker::backdrop {
		background: color-mix(in oklch, black 42%, transparent);
	}

	.tag-picker__panel {
		display: flex;
		flex-direction: column;
		max-height: min(70vh, 32rem);
	}

	.tag-picker__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.1rem 0.75rem;
		border-bottom: 1px solid color-mix(in oklch, var(--color-global-text) 10%, transparent);
	}

	.tag-picker__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
	}

	.tag-picker__close {
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: none;
		border-radius: 0.4rem;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		font-size: 1.4rem;
		line-height: 1;
	}

	.tag-picker__close:hover {
		color: var(--color-accent);
	}

	.tag-picker__list {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		padding: 0.6rem 0.55rem 0.75rem;
		overflow: auto;
		list-style: none;
	}

	.tag-picker__link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.tag-picker__link:hover,
	.tag-picker__link.is-current {
		background: color-mix(in oklch, var(--color-brand) 10%, transparent);
		color: var(--color-accent);
	}

	.tag-picker__count {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-muted);
	}
</style>
