---
import { buildPhotoSrcSet, type Photo, photoFullUrl } from "@/data/gallery";

type Props = {
	image: Photo;
	sizes: string;
};

const { image, sizes } = Astro.props;
const full = photoFullUrl(image.src, 1400);
const srcset = buildPhotoSrcSet(image.src, [600, 900, 1400]);
---

<figure class="photo-figure">
	<a
		href={full}
		data-photo-src={full}
		data-photo-alt={image.alt}
		aria-label={image.alt || image.slug}
	>
		<img
			src={image.previewSrc ?? full}
			srcset={srcset}
			sizes={sizes}
			alt={image.alt}
			width={image.width}
			height={image.height}
			loading="lazy"
			decoding="async"
		/>
	</a>
</figure>

<style>
	a {
		display: block;
	}

	figure {
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
