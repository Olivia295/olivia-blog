---
import { buildPhotoSrcSet, photoFullUrl, type Photo } from "@/data/gallery";

type Props = {
	image: Photo;
	sizes: string;
};

const { image, sizes } = Astro.props;
const full = photoFullUrl(image.src, 1400);
const srcset = buildPhotoSrcSet(image.src, [600, 900, 1400]);
---

<figure>
	<img
		src={full}
		srcset={srcset}
		sizes={sizes}
		alt={image.alt}
		width={image.width}
		height={image.height}
		loading="lazy"
		decoding="async"
	/>
	{image.alt ? <figcaption>{image.alt}</figcaption> : null}
</figure>

<style>
	figure {
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--color-global-text) 6%, transparent);
	}

	figcaption {
		margin-top: 0.45rem;
		font-size: 0.8rem;
		color: var(--color-muted);
	}
</style>
