---
import type { Lang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";
import { menuLinkDefs, siteConfig } from "@/site.config";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const menuLinks = menuLinkDefs.map((link) => ({
	path: localePath(lang, link.path),
	title: t(link.titleKey),
}));
---

<footer
	class="text-muted mt-auto flex w-full flex-col items-center justify-center gap-y-3 pt-16 pb-6 text-center align-top text-xs font-semibold sm:flex-row sm:justify-between sm:gap-y-2 sm:pt-20 sm:pb-4"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.author}
		{year}.<span class="inline-block">&nbsp;·&nbsp;{siteConfig.title}</span>
	</div>
	<nav aria-labelledby="footer_links" class="sm:divide-muted flex gap-x-2 sm:gap-x-0 sm:divide-x">
		<p id="footer_links" class="sr-only">{t("nav.siteLinks")}</p>
		{
			menuLinks.map((link) => (
				<a class="hover:text-global-text px-4 py-2 hover:underline sm:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
