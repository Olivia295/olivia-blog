---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Lang } from "@/i18n/config";
import { localePath, stripLocalePrefix, useTranslations } from "@/i18n/utils";
import { siteLogoSrc } from "@/data/site-assets";
import { menuLinkDefs, siteConfig } from "@/site.config";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = localePath(lang, "/");
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentBare = stripLocalePrefix(Astro.url.pathname).replace(/\/+$/, "") || "/";

function normalize(path: string) {
	return path.replace(/\/+$/, "") || "/";
}

function navIsCurrent(href: string, isHome = false) {
	const target = normalize(href);
	if (isHome) {
		return currentPath === target || currentPath === `/${lang}`;
	}
	if (currentPath === target || currentPath.startsWith(`${target}/`)) return true;

	const targetBare = stripLocalePrefix(target).replace(/\/+$/, "") || "/";
	if (
		targetBare === "/gallery" &&
		(currentBare === "/photos" || currentBare.startsWith("/photos/"))
	) {
		return true;
	}
	if (targetBare === "/blogs" && (currentBare === "/tags" || currentBare.startsWith("/tags/"))) {
		return true;
	}
	return false;
}

const menuLinks = menuLinkDefs.map((link) => ({
	path: localePath(lang, link.path),
	title: t(link.titleKey),
	current: navIsCurrent(localePath(lang, link.path), link.path === "/"),
}));
---

<header class="site-header" id="main-header">
	<div class="header-top">
		<a
			aria-current={navIsCurrent(homeHref, true) ? "page" : undefined}
			aria-label={siteConfig.title}
			class="site-logo"
			href={homeHref}
		>
			<img alt="" class="site-mark" height="64" src={siteLogoSrc} width="64" />
			<span class="site-wordmark">{siteConfig.title}</span>
		</a>
		<div class="header-tools">
			<Search lang={lang} />
			<LanguageSwitcher lang={lang} />
			<ThemeToggle lang={lang} />
		</div>
	</div>
	<nav aria-label={t("nav.main")} class="site-nav" id="navigation-menu">
		{
			menuLinks.map((link) => (
				<a
					aria-current={link.current ? "page" : undefined}
					class:list={["site-nav__link", { "is-current": link.current }]}
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		flex: 0 0 auto;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin-bottom: 1.15rem;
		animation: Spaceship-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.header-top {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		width: 100%;
		min-width: 0;
		min-height: 1.7rem;
	}

	.site-logo {
		display: flex;
		flex: 0 1 auto;
		min-width: 0;
		align-items: center;
		gap: 0.35rem;
		color: inherit;
		text-decoration: none;
	}

	.site-logo:active {
		opacity: 0.75;
	}

	.site-mark {
		width: 1.4rem;
		height: 1.4rem;
		flex-shrink: 0;
		border-radius: 0.32rem;
		object-fit: cover;
		background: #2b2e33;
	}

	.site-wordmark {
		flex: 0 0 auto;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.2;
		white-space: nowrap;
	}

	.header-tools {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.05rem;
		margin-inline-start: auto;
	}

	.header-tools :global(#search),
	.header-tools :global(theme-toggle) {
		display: block;
		flex: 0 0 1.7rem;
		width: 1.7rem;
		height: 1.7rem;
		overflow: hidden;
		margin: 0;
	}

	.header-tools :global(site-search > dialog) {
		position: fixed;
	}

	.header-tools :global(site-search > dialog:not([open])) {
		display: none;
	}

	.header-tools :global(site-search > button),
	.header-tools :global(theme-toggle > button) {
		width: 1.7rem;
		height: 1.7rem;
		padding: 0;
	}

	.header-tools :global(theme-toggle > button svg) {
		width: 1.05rem;
		height: 1.05rem;
	}

	.header-tools :global(site-search > button svg) {
		width: 1.05rem;
		height: 1.05rem;
	}

	.header-tools :global(.lang-switch) {
		margin-inline: 0;
	}

	.site-nav {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: center;
		gap: 0;
		margin-top: 0.4rem;
		padding-top: 0.15rem;
		min-height: 1.7rem;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.site-nav::-webkit-scrollbar {
		display: none;
	}

	.site-nav__link {
		--nav-end: 0.7rem;
		position: relative;
		flex-shrink: 0;
		padding: 0.2rem var(--nav-end) 0.35rem 0;
		margin-inline-end: var(--nav-end);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--color-muted);
		text-decoration: none;
		border-inline-end: 1px solid color-mix(in oklch, var(--color-global-text) 14%, transparent);
	}

	.site-nav__link:last-child {
		margin-inline-end: 0;
		padding-inline-end: 0;
		border-inline-end: none;
	}

	.site-nav__link[aria-current="page"],
	.site-nav__link.is-current {
		color: var(--color-accent);
	}

	.site-nav__link[aria-current="page"]::after,
	.site-nav__link.is-current::after {
		content: "";
		position: absolute;
		left: 0;
		right: var(--nav-end);
		bottom: 0;
		height: 2px;
		border-radius: 1px;
		background: var(--color-accent);
	}

	.site-nav__link:last-child[aria-current="page"]::after,
	.site-nav__link:last-child.is-current::after {
		right: 0;
	}

	.site-nav__link:hover,
	.site-nav__link:active {
		color: var(--color-accent);
	}

	@media (min-width: 640px) {
		.site-header {
			margin-bottom: 2rem;
		}

		.site-mark {
			width: 1.7rem;
			height: 1.7rem;
			border-radius: 0.38rem;
		}

		.site-wordmark {
			font-size: 1.05rem;
			letter-spacing: -0.04em;
		}

		.header-tools {
			gap: 0.1rem;
		}

		.header-tools :global(#search),
		.header-tools :global(theme-toggle) {
			flex-basis: 2rem;
			width: 2rem;
			height: 2rem;
		}

		.header-tools :global(site-search > button),
		.header-tools :global(theme-toggle > button) {
			width: 2rem;
			height: 2rem;
		}

		.header-tools :global(theme-toggle > button svg),
		.header-tools :global(site-search > button svg) {
			width: 1.15rem;
			height: 1.15rem;
		}

		.site-nav {
			margin-top: 0.45rem;
			padding-top: 0.15rem;
		}

		.site-nav__link {
			--nav-end: 0.85rem;
			padding: 0.15rem var(--nav-end) 0.35rem 0;
			margin-inline-end: var(--nav-end);
			font-size: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			animation: none !important;
		}
	}
</style>
