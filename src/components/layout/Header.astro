---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Lang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";
import { menuLinkDefs, siteConfig } from "@/site.config";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = localePath(lang, "/");
const menuLinks = menuLinkDefs.map((link) => ({
	path: localePath(lang, link.path),
	title: t(link.titleKey),
}));
---

<header class="site-header" id="main-header">
	<div class="header-top">
		<a
			aria-current={Astro.url.pathname === homeHref || Astro.url.pathname === `/${lang}` ? "page" : false}
			aria-label={siteConfig.title}
			class="site-logo"
			href={homeHref}
		>
			<img alt="" class="site-mark" height="64" src="/logo.png" width="64" />
			<span class="site-wordmark">{siteConfig.title}</span>
		</a>
		<div class="header-tools">
			<Search lang={lang} />
			<LanguageSwitcher lang={lang} />
			<ThemeToggle lang={lang} />
		</div>
	</div>
	<nav aria-label={t("nav.main")} class="site-nav" id="navigation-menu">
		{
			menuLinks.map((link) => (
				<a
					aria-current={
						Astro.url.pathname === link.path ||
						Astro.url.pathname === `${link.path}`.replace(/\/$/, "")
							? "page"
							: false
					}
					class="site-nav__link"
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		min-width: 0;
		margin-bottom: 1.75rem;
		animation: kitchen-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
		z-index: 50;
	}

	.header-top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.site-logo {
		display: inline-flex;
		min-width: 0;
		flex: 1;
		align-items: center;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.site-logo:active {
		opacity: 0.75;
	}

	.site-mark {
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
		border-radius: 0.45rem;
		object-fit: cover;
		background: #2b2e33;
	}

	.site-wordmark {
		min-width: 0;
		overflow: hidden;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.header-tools {
		display: flex;
		flex-shrink: 0;
		align-items: center;
	}

	.site-nav {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 0.45rem;
		margin-inline-start: -0.45rem;
	}

	.site-nav__link {
		padding: 0.35rem 0.55rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
		border-inline-end: 1px solid color-mix(in oklch, var(--color-global-text) 14%, transparent);
	}

	.site-nav__link:last-child {
		border-inline-end: none;
	}

	.site-nav__link:hover,
	.site-nav__link:active {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (min-width: 640px) {
		.site-header {
			margin-bottom: 4.5rem;
		}

		.site-mark {
			width: 2.35rem;
			height: 2.35rem;
			border-radius: 0.55rem;
		}

		.site-wordmark {
			font-size: 1.5rem;
			text-overflow: clip;
			overflow: visible;
		}

		.site-nav {
			margin-top: 0.4rem;
			margin-inline-start: -0.85rem;
		}

		.site-nav__link {
			padding: 0.15rem 0.85rem;
			font-size: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			animation: none !important;
		}
	}
</style>
