---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { sectionLinks } from "@/data/navigation";
import { siteLogoSrc } from "@/data/site-assets";
import type { Lang } from "@/i18n/config";
import { localePath, stripLocalePrefix, useTranslations } from "@/i18n/utils";
import { siteConfig } from "@/site.config";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = localePath(lang, "/");
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentBare = stripLocalePrefix(Astro.url.pathname).replace(/\/+$/, "") || "/";

function normalize(path: string) {
	return path.replace(/\/+$/, "") || "/";
}

function navIsCurrent(href: string, isHome = false) {
	const target = normalize(href);
	if (isHome) {
		return currentPath === target || currentPath === `/${lang}`;
	}
	if (currentPath === target || currentPath.startsWith(`${target}/`)) return true;

	const targetBare = stripLocalePrefix(target).replace(/\/+$/, "") || "/";
	if (
		targetBare === "/gallery" &&
		(currentBare === "/photos" || currentBare.startsWith("/photos/"))
	) {
		return true;
	}
	if (targetBare === "/blogs" && (currentBare === "/tags" || currentBare.startsWith("/tags/"))) {
		return true;
	}
	return false;
}

const menuLinks = (await sectionLinks()).map((link) => ({
	path: localePath(lang, link.path),
	title: t(link.titleKey),
	current: navIsCurrent(localePath(lang, link.path), link.path === "/"),
}));
---

<header class="site-header" id="main-header">
	<div class="header-top">
		<a
			aria-current={navIsCurrent(homeHref, true) ? "page" : undefined}
			aria-label={siteConfig.title}
			class="site-logo"
			href={homeHref}
		>
			<img alt="" class="site-mark" height="64" src={siteLogoSrc} width="64" />
			<span class="site-wordmark">{siteConfig.title}</span>
		</a>
		<div class="header-tools">
			<Search lang={lang} />
			<ThemeToggle lang={lang} />
			<LanguageSwitcher lang={lang} />
		</div>
	</div>
	<nav aria-label={t("nav.main")} class="site-nav" id="navigation-menu">
		{
			menuLinks.map((link) => (
				<a
					aria-current={link.current ? "page" : undefined}
					class:list={["site-nav__link", { "is-current": link.current }]}
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>("#main-header");
	if (header) {
		// Reuse one search instance and keep tab order aligned with each layout.
		const desktop = matchMedia("(min-width: 900px)");
		const nav = header.querySelector("nav")!;
		const search = header.querySelector("#search")!;
		const arrangeNavigation = () => {
			if (desktop.matches) search.after(nav);
			else header.append(nav);
		};
		arrangeNavigation();
		desktop.addEventListener("change", arrangeNavigation);
		const updateOffset = () =>
			document.documentElement.style.setProperty(
				"--header-height",
				`${header.getBoundingClientRect().height}px`,
			);
		updateOffset();
		new ResizeObserver(updateOffset).observe(header);
	}
</script>

<style>
	.site-header {
		width: min(100% - 40px, 1160px);
		margin: 12px auto 0;
		padding: 10px 22px;
		position: sticky;
		top: 8px;
		z-index: 90;
	}
	.header-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		min-width: 0;
	}
	.site-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}
	.site-mark {
		width: 28px;
		height: 28px;
		object-fit: cover;
		flex-shrink: 0;
	}
	.site-wordmark {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.header-tools {
		display: flex;
		gap: 5px;
		flex-shrink: 0;
		align-items: center;
	}
	.header-tools :global(#search),
	.header-tools :global(theme-toggle) {
		display: block;
		width: 44px;
		height: 44px;
		overflow: visible;
		margin: 0;
	}
	.header-tools :global(site-search > button),
	.header-tools :global(theme-toggle > button) {
		width: 44px;
		height: 44px;
		padding: 10px;
	}
	.header-tools :global(button svg) {
		width: 21px;
		height: 21px;
	}
	.site-nav {
		display: flex;
		align-items: center;
		gap: 22px;
		margin-top: 5px;
		flex-wrap: wrap;
	}
	.site-nav__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	@media (min-width: 900px) {
		.site-header {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 24px;
			padding: 10px 22px;
		}
		.header-top {
			display: contents;
		}
		.site-logo {
			flex: 1;
		}
		.header-tools {
			gap: 16px;
		}
		.site-nav {
			margin: 0;
			gap: 24px;
		}
		.site-wordmark {
			max-width: 310px;
		}
	}
	@media (max-width: 600px) {
		.site-header {
			width: calc(100% - 24px);
			padding: 6px 10px 0;
		}
		.header-top {
			gap: 8px;
		}
		.site-logo {
			flex: 1 1 auto;
		}
		.header-tools {
			gap: 0;
		}
		.site-nav {
			display: grid;
			grid-auto-columns: 1fr;
			grid-auto-flow: column;
			gap: 0;
			margin-top: 0;
			border-top: 1px solid color-mix(in srgb, currentColor 8%, transparent);
		}
		.site-nav__link {
			justify-self: center;
		}
		.site-mark {
			width: 24px;
			height: 24px;
		}
	}
</style>
