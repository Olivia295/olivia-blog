---
import { type CollectionEntry, render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl } from "@/i18n/utils";

type Props = {
	post: CollectionEntry<"post">;
	lang?: Lang;
	plain?: boolean;
};

const { post, lang: langProp, plain = false } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const { Content } = await render(post);
---

<article class:list={["note-card", { "note-card--plain": plain }]} id={`post-${post.id}`} data-pagefind-body>
	<header class="note-card__header">
		<FormattedDate
			class="note-card__date"
			dateTimeOptions={{
				hour: "2-digit",
				minute: "2-digit",
				year: "numeric",
				month: "short",
				day: "numeric",
			}}
			date={post.data.publishDate}
			lang={lang}
		/>
	</header>
	<div class="note-card__body prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</article>

<script>
	const zoom = document.getElementById("note-zoom") as HTMLDialogElement | null;
	const zoomImg = zoom?.querySelector("img");

	document.querySelectorAll<HTMLElement>(".note-card__body").forEach((body) => {
		if (body.dataset.shotsPacked === "true") return;
		const imgs = [...body.querySelectorAll<HTMLImageElement>("img")];
		body.dataset.shotsPacked = "true";
		if (!imgs.length) return;

		const row = document.createElement("div");
		row.className = "note-shots";
		for (const img of imgs) {
			const parent = img.parentElement;
			const cell = document.createElement("span");
			cell.className = "note-shots__cell";
			cell.append(img);
			row.append(cell);
			if (parent?.tagName === "P" && parent !== body && !parent.textContent?.trim()) parent.remove();
			img.addEventListener("click", () => {
				if (!zoom || !zoomImg) return;
				zoomImg.src = img.currentSrc || img.src;
				zoomImg.alt = img.alt;
				zoom.showModal();
			});
		}
		body.append(row);
	});
</script>

<style>
	.note-card {
		display: grid;
		gap: 0.75rem;
		padding: 1rem 1rem 1.15rem;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--color-global-text) 5%, transparent);
		border: 1px solid color-mix(in oklch, var(--color-global-text) 8%, transparent);
		transition:
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.25s ease,
			border-color 0.25s ease;
	}

	@media (min-width: 640px) {
		.note-card {
			padding: 1.1rem 1.15rem 1.25rem;
		}
		.note-card:hover {
			transform: translateY(-2px);
			border-color: color-mix(in oklch, var(--color-accent) 28%, transparent);
			box-shadow: 0 10px 28px color-mix(in oklch, var(--color-global-text) 8%, transparent);
		}
	}

	.note-card:active {
		transform: scale(0.995);
	}

	.note-card--plain {
		padding: 0 0 1.35rem;
		border: none;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	.note-card--plain:hover,
	.note-card--plain:active {
		transform: none;
		border: none;
		box-shadow: none;
	}

	.note-card--plain .note-card__header {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
	}

	@media (min-width: 640px) {
		.note-card--plain .note-card__header {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
		}
	}

	.note-card__header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
	}

	.note-card__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.note-card__date {
		font-size: 0.75rem;
		opacity: 0.6;
		font-weight: 600;
	}

	.note-card__body {
		min-width: 0;
	}

	.note-card__body :global(img) {
		display: inline-block;
		width: calc((100% - 1.35rem) / 4);
		aspect-ratio: 1;
		max-width: 100%;
		margin: 0.85rem 0.45rem 0 0;
		border-radius: 0.65rem;
		object-fit: cover;
		vertical-align: top;
		cursor: zoom-in;
		background: color-mix(in oklch, var(--color-global-text) 6%, transparent);
	}

	.note-card__body :global(.note-shots) {
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		align-items: stretch;
		gap: 0.45rem;
		width: 100%;
		margin-top: 0.85rem;
	}

	.note-card__body :global(.note-shots__cell) {
		flex: 0 0 calc((100% - 1.35rem) / 4);
		width: calc((100% - 1.35rem) / 4);
		max-width: calc((100% - 1.35rem) / 4);
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 0.65rem;
		background: color-mix(in oklch, var(--color-global-text) 6%, transparent);
	}

	.note-card__body :global(.note-shots img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		object-fit: cover;
		cursor: zoom-in;
	}

	.note-card__body :global(p:last-child) {
		margin-bottom: 0;
	}

	.note-card__body :global(a) {
		color: var(--color-link);
	}
</style>
