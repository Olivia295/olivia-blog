---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { defaultLang, htmlLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	lang?: Lang;
	wide?: boolean;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const {
	meta: { articleDate, description = t("site.description"), ogImage, title },
} = Astro.props;
---

<html class="scroll-smooth" lang={htmlLang[lang]}>
	<head>
		<BaseHead
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
			lang={lang}
		/>
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex h-dvh w-full min-w-0 max-w-5xl flex-col overflow-hidden px-4 pt-8 font-mono text-sm font-normal antialiased sm:px-8 sm:pt-16"
	>
		<SkipLink lang={lang} />
		<Header lang={lang} />
		<div class="page-scroll">
			<main id="main" class="site-main">
				<slot />
			</main>
			<Footer />
		</div>
		<dialog class="note-zoom" id="note-zoom" onclick="this.close()">
			<img alt="" />
		</dialog>
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>

<style>
	.page-scroll {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		width: 100%;
		min-width: 0;
		min-height: 0;
		overflow-x: clip;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 1.5rem;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.page-scroll::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
		background: transparent;
	}

	:global(html),
	:global(body) {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	:global(html::-webkit-scrollbar),
	:global(body::-webkit-scrollbar) {
		display: none;
		width: 0;
		height: 0;
	}

	.site-main {
		flex: 1 0 auto;
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}
</style>
