---
import BaseHead from "@/components/BaseHead.astro";
import PhotoViewer from "@/components/gallery/PhotoViewer.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { isSampleContent, settings } from "@/data/settings";
import { defaultLang, htmlLang, type Lang } from "@/i18n/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import SkinProvider from "@/skins/SkinProvider.astro";
import SkinSlot from "@/skins/SkinSlot.astro";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	lang?: Lang;
	wide?: boolean;
	home?: boolean;
	reading?: boolean;
}

const sample = isSampleContent();
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const {
	meta: { articleDate, description = t("site.description"), ogImage, title },
} = Astro.props;
---

<html
	lang={htmlLang[lang]}
	data-skin={settings.defaultSkin}
	data-default-skin={settings.defaultSkin}
>
	<head>
		<BaseHead
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
			lang={lang}
		/>
		<SkinProvider />
		<ThemeProvider />
	</head>
	<body class:list={[{ "is-home": Astro.props.home, "is-reading": Astro.props.reading }]}>
		<SkipLink lang={lang} />
		<SkinSlot position="surround" lang={lang} />
		{
			sample && (
				<p class="sample-banner">
					{lang === "zh"
						? "示例站点 · 此处使用虚构资料与示例内容"
						: "Demo site · Fictional profile and sample content"}
				</p>
			)
		}
		<Header lang={lang} />
		<main
			id="main"
			tabindex="-1"
			class:list={[
				"site-main",
				{ "site-main--home": Astro.props.home, "site-main--reading": Astro.props.reading },
			]}
		>
			<SkinSlot position="content-start" lang={lang} />
			<slot />
		</main>
		<Footer lang={lang} home={!!Astro.props.home} />
		<SkinSlot position="page-end" lang={lang} home={!!Astro.props.home} />
		<PhotoViewer lang={lang} />
	</body>
</html>
