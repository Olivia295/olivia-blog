---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import CopyLink from "@/components/CopyLink.astro";
import FloatingBack from "@/components/FloatingBack.astro";
import MusicPlayer from "@/components/MusicPlayer.astro";
import { getAllBlogs } from "@/data/blog";
import { resolvePostMusic } from "@/data/music";
import { seriesNeighbors } from "@/data/reading";
import { seriesCatalog } from "@/data/site-series";
import { defaultLang, type Lang } from "@/i18n/config";
import { getLangFromUrl } from "@/i18n/utils";
import { siteConfig } from "@/site.config";
import { generateToc } from "@/utils/generateToc";
import "@/styles/reading.css";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"blog">;
	lang?: Lang;
}

const { post, lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url) ?? defaultLang;
const { ogImage, title, description, updatedDate, publishDate, music } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTimeMinutes: number =
	typeof remarkPluginFrontmatter.readingTimeMinutes === "number"
		? remarkPluginFrontmatter.readingTimeMinutes
		: 1;
const postSongs = resolvePostMusic(music);
const showMusicSlot = Boolean(postSongs) || Astro.slots.has("music");
const hasToc = generateToc(headings).length > 0;
const related = [
	...new Map(
		seriesNeighbors(post, await getAllBlogs(), seriesCatalog)
			.flatMap(({ previous, next }) => [previous, next])
			.filter((entry) => entry !== undefined)
			.map((entry) => [entry.id, entry]),
	).values(),
].slice(0, 2);
const permalink = new URL(`/${lang}/blogs/${post.id}/`, siteConfig.url).href;
---

<BaseLayout
	reading
	lang={lang}
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<div class="reading-progress" aria-hidden="true"><span></span></div>
	<article class="grow break-words" data-pagefind-body>
		<div id="blog-hero" class="mb-12">
			<Masthead content={post} readingTimeMinutes={readingTimeMinutes} lang={lang}>
				<CopyLink slot="actions" url={permalink} lang={lang} />
			</Masthead>
		</div>
		<div class:list={["reading-layout", { "reading-layout--with-toc": hasToc }]}>
			{hasToc && <TOC headings={headings} lang={lang} />}
			<div class="reading-body prose">
				{
					showMusicSlot && (
						<aside class="not-prose mb-8" data-pagefind-ignore>
							<slot name="music">{postSongs && <MusicPlayer songs={postSongs} lang={lang} />}</slot>
						</aside>
					)
				}
				<div class="article-content"><slot /></div>
				<footer class="article-end not-prose" data-pagefind-ignore>
					{
						related.length > 0 && (
							<nav
								class="article-related"
								aria-label={lang === "zh" ? "继续阅读" : "Continue reading"}
							>
								<p class="article-related__label">
									{lang === "zh" ? "继续阅读" : "Continue reading"}
								</p>
								<ul role="list">
									{related.map((entry) => (
										<li>
											<a class="paper-link" href={`/${lang}/blogs/${entry.id}/`}>
												<span>{entry.data.title}</span>
												<span aria-hidden="true">→</span>
											</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<a class="article-back paper-action" href={`/${lang}/blogs/`}>
						<svg
							class="paper-action__icon"
							width="18"
							height="18"
							viewBox="0 0 20 20"
							fill="none"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"><path d="m8 4-6 6 6 6M3 10h14"></path></svg
						>
						<span class="action-label">{lang === "zh" ? "返回文章列表" : "All articles"}</span>
					</a>
				</footer>
				<WebMentions />
			</div>
		</div>
	</article>

	<FloatingBack />
</BaseLayout>

<script>
	const bar = document.querySelector<HTMLElement>(".reading-progress span");
	const article = document.querySelector<HTMLElement>(".article-content");
	if (bar && article) {
		let queued = false;
		const update = () => {
			queued = false;
			const { top, height } = article.getBoundingClientRect();
			const span = Math.max(1, height - innerHeight * 0.6);
			bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -top / span))})`;
		};
		const schedule = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		addEventListener("scroll", schedule, { passive: true });
		addEventListener("resize", schedule);
		update();
	}
</script>

<style>
	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		height: 3px;
		pointer-events: none;
	}
	.reading-progress span {
		display: block;
		height: 100%;
		background: var(--color-brand);
		transform: scaleX(0);
		transform-origin: left center;
	}
	@media print {
		.reading-progress {
			display: none;
		}
	}
</style>
