---
import { settings } from "@/data/settings";
import { skins, findSkin } from "@/skins/registry";
import { defaultLang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const lang = defaultLang;
const t = useTranslations(lang);
const skinCopies = Object.fromEntries(skins.map((skin) => [skin.id, skin.copy ?? {}]));
const skinCopy = findSkin(settings.defaultSkin)?.copy ?? {};

const meta = {
	description: t("404.body"),
	title: t("404.title"),
};

const homeZh = localePath("zh", "/");
const homeEn = localePath("en", "/");
const blogsZh = localePath("zh", "/blogs/");
const postsZh = localePath("zh", "/posts/");
---

<PageLayout lang={lang} meta={meta}>
	<section class="not-found motion-soft-pop" data-404>
		<p class="not-found__code" aria-hidden="true">{t("404.code")}</p>
		<h1 class="title not-found__heading">{skinCopy.notFoundHeading?.[lang] ?? t("404.heading")}</h1>
		<p class="not-found__body" data-404-body>{skinCopy.notFoundBody?.[lang] ?? t("404.body")}</p>

		<div class="not-found__actions">
			<a class="not-found__btn not-found__btn--primary motion-press" href={homeZh} data-404-home>
				{skinCopy.notFoundHome?.[lang] ?? t("404.home")}
			</a>
			<a class="not-found__btn motion-press" href={blogsZh} data-404-blogs>
				{t("404.blogs")}
			</a>
			<a class="not-found__btn motion-press" href={postsZh} data-404-posts>
				{t("404.posts")}
			</a>
		</div>

		<p class="not-found__lang">
			<a href={homeZh}>中文首页</a>
			<span aria-hidden="true"> · </span>
			<a href={homeEn}>English home</a>
		</p>

		<p class="not-found__brand">{siteConfig.title}</p>
	</section>
</PageLayout>

{/* Localize CTAs from cookie / path when possible (static 404 is zh by default). */}
<script is:inline define:vars={{ skinCopies }}>
	(function () {
		const ui = {
			zh: {
				heading: "这里什么都没有",
				body: "这个页面暂时没有内容。回到首页，或者看看其他分享。",
				home: "返回首页",
				blogs: "去看文章",
				posts: "去看动态",
			},
			en: {
				heading: "Page not found",
				body: "This page is unavailable. Head home, or browse another story.",
				home: "Back home",
				blogs: "Browse blogs",
				posts: "Browse posts",
			},
		};

		function readCookie(name) {
			const m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
			return m ? decodeURIComponent(m[1]) : null;
		}

		const cookie = readCookie("locale");
		const pathHint = location.pathname.split("/").filter(Boolean)[0];
		let lang = "zh";
		if (cookie === "zh" || cookie === "en") lang = cookie;
		else if (pathHint === "en" || pathHint === "zh") lang = pathHint;
		else if ((navigator.language || "").toLowerCase().startsWith("zh")) lang = "zh";
		else lang = "en";

		const copy = ui[lang] || ui.zh;
		const root = document.querySelector("[data-404]");
		if (!root) return;

		const heading = root.querySelector(".not-found__heading");
		const body = root.querySelector("[data-404-body]");
		const home = root.querySelector("[data-404-home]");
		const blogs = root.querySelector("[data-404-blogs]");
		const posts = root.querySelector("[data-404-posts]");

		const updateSkinCopy = () => {
			const themed = skinCopies[document.documentElement.dataset.skin] || {};
			if (heading) heading.textContent = themed.notFoundHeading?.[lang] || copy.heading;
			if (body) body.textContent = themed.notFoundBody?.[lang] || copy.body;
			if (home) home.textContent = themed.notFoundHome?.[lang] || copy.home;
		};
		updateSkinCopy();
		document.addEventListener("skin-applied", updateSkinCopy);
		if (home) {
			home.setAttribute("href", "/" + lang + "/");
		}
		if (blogs) {
			blogs.textContent = copy.blogs;
			blogs.setAttribute("href", "/" + lang + "/blogs/");
		}
		if (posts) {
			posts.textContent = copy.posts;
			posts.setAttribute("href", "/" + lang + "/posts/");
		}
		document.documentElement.lang = lang === "zh" ? "zh-CN" : "en-GB";
	})();
</script>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		min-height: min(58vh, 28rem);
		padding: 1rem 0 3rem;
		gap: 0.75rem;
	}

	.not-found__code {
		margin: 0;
		user-select: none;
	}

	.not-found__heading {
		margin: 0;
	}

	.not-found__body {
		margin: 0;
		max-width: 28rem;
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.not-found__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.55rem 1rem;
	}

	.not-found__lang {
		margin: 1.5rem 0 0;
	}

	.not-found__lang a {
		text-underline-offset: 2px;
	}

	.not-found__brand {
		margin: 2rem 0 0;
	}

	@media (max-width: 639px) {
		.not-found__actions {
			width: 100%;
			flex-direction: column;
		}
		.not-found__btn {
			width: 100%;
		}
	}
</style>
