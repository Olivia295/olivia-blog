---
import { Icon } from "astro-icon/components";
import FloatingBack from "@/components/FloatingBack.astro";
import PageHeader from "@/components/PageHeader.astro";
import { profile } from "@/data/profile";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const meta = {
	description: t("about.description"),
	title: t("about.title"),
};

const role = profile.role[lang];
const bio = profile.bio[lang];
const portraitAlt = profile.portraitAlt[lang];
const facts = profile.facts[lang];
---

<PageLayout lang={lang} meta={meta}>
	<section class="about motion-fade-up">
		<PageHeader title={t("about.title")} lead={t("about.lead")} />

		<div class="about__layout">
			<figure class="about__portrait">
				<img
					src={profile.portraitSrc}
					alt={portraitAlt}
					width="640"
					height="800"
					loading="eager"
					decoding="async"
					class="about__portrait-img"
				/>
			</figure>

			<div class="about__body">
				<p class="about__name">{profile.name}</p>
				<p class="about__role">{role}</p>
				<div class="about__bio">
					{bio.map((para) => <p>{para}</p>)}
				</div>

				<div class="about__links-block">
					<p class="about__links-label">{t("about.findMe")}</p>
					<ul class="about__links" role="list">
						{
							profile.links.map((link) => (
								<li>
									<a
										class="about__link"
										href={link.href}
										target={link.href.startsWith("mailto:") ? undefined : "_blank"}
										rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
									>
										<Icon aria-hidden="true" class="about__link-icon" name={link.icon} />
										<span>{link.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<section class="about__info" aria-labelledby="about-info-heading">
			<p class="about__links-label" id="about-info-heading">{t("about.info")}</p>
			<dl class="about__facts">
				{
					facts.map((fact) => (
						<div class="about__fact">
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</section>

	<FloatingBack />
</PageLayout>

<style>
	.about {
		padding-bottom: 1.5rem;
	}

	.about__layout {
		display: grid;
		gap: 1.75rem;
	}

	@media (min-width: 640px) {
		.about__layout {
			grid-template-columns: minmax(10rem, 13.5rem) 1fr;
			gap: 2rem;
			align-items: start;
		}
	}

	.about__portrait {
		margin: 0;
		justify-self: center;
		width: min(100%, 14rem);
	}

	@media (min-width: 640px) {
		.about__portrait {
			width: 100%;
			justify-self: stretch;
		}
	}

	.about__portrait-img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center 20%;
		border-radius: 1rem;
	}

	.about__name {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.about__role {
		margin: 0.35rem 0 0;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--color-accent);
	}

	.about__bio {
		margin-top: 1rem;
		display: grid;
		gap: 0.7rem;
		font-size: 0.9rem;
		line-height: 1.7;
		opacity: 0.88;
	}

	.about__bio p {
		margin: 0;
	}

	.about__links-block {
		margin-top: 1.35rem;
	}

	.about__links-label {
		margin: 0 0 0.65rem;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.5;
		font-weight: 700;
	}

	.about__links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	@media (min-width: 480px) {
		.about__links {
			grid-template-columns: 1fr 1fr;
		}
	}

	.about__link {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.5rem;
		color: inherit;
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 600;
		opacity: 0.88;
		transition: color 0.15s ease, opacity 0.15s ease;
	}

	.about__link:hover {
		opacity: 1;
		color: var(--color-accent);
	}

	.about__link-icon {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}

	.about__info {
		display: block;
		width: 100%;
		box-sizing: border-box;
		margin-top: 2.75rem;
		padding-top: 2rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 12%, transparent);
		text-align: center;
	}

	.about__info .about__links-label {
		margin-bottom: 1.15rem;
	}

	.about__facts {
		margin: 0 auto;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.35rem 1.75rem;
		max-width: 34rem;
		text-align: center;
	}

	@media (min-width: 720px) {
		.about__facts {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			max-width: 42rem;
		}
	}

	.about__fact {
		margin: 0;
		min-width: 0;
	}

	.about__fact dt {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.42;
		font-weight: 700;
	}

	.about__fact dd {
		margin: 0.4rem 0 0;
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.88;
	}
</style>
