---
import { Icon } from "astro-icon/components";
import FloatingBack from "@/components/FloatingBack.astro";
import PageHeader from "@/components/PageHeader.astro";
import { pageLead } from "@/data/page-copy";
import { profile } from "@/data/profile";
import { publicImageSize } from "@/data/site-assets";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const meta = {
	description: t("about.description"),
	title: t("about.title"),
};

const role = profile.role[lang];
const bio = profile.bio[lang];
const portraitAlt = profile.portraitAlt[lang];
const facts = profile.facts[lang];
const portraitSize = await publicImageSize(profile.portraitSrc);
---

<PageLayout lang={lang} meta={meta}>
	<section class="about motion-fade-up">
		<PageHeader title={t("about.title")} lead={pageLead("about", lang, t("about.lead"))} />

		<div class="about__layout">
			<figure class="about__portrait">
				<img
					src={profile.portraitSrc}
					alt={portraitAlt}
					width={portraitSize?.width ?? undefined}
					height={portraitSize?.height ?? undefined}
					loading="eager"
					decoding="async"
					class="about__portrait-img"
				/>
			</figure>

			<div class="about__body">
				<p class="about__name">{profile.name}</p>
				<p class="about__role">{role}</p>

				<div class="about__info" aria-labelledby="about-info-heading">
					<p class="about__label" id="about-info-heading">{t("about.info")}</p>
					<dl class="about__facts">
						{
							facts.map((fact) => (
								<div class="about__fact">
									<dt>{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</div>

		<div class="about__bio">
			{bio.map((para) => <p>{para}</p>)}
		</div>

		<section class="about__friends" aria-labelledby="about-friends-heading">
			<p class="about__label" id="about-friends-heading">{t("about.findMe")}</p>
			<ul class="about__links" role="list">
				{
					profile.links.map((link) => (
						<li>
							<a
								class="about__link"
								href={link.href}
								target={link.href.startsWith("mailto:") ? undefined : "_blank"}
								rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
							>
								<Icon aria-hidden="true" class="about__link-icon" name={link.icon} />
								<span>{link.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</section>

	<FloatingBack />
</PageLayout>

<style>
	.about {
		padding-bottom: 1.5rem;
	}

	.about__layout {
		display: grid;
		gap: 1.35rem;
	}

	@media (min-width: 640px) {
		.about__layout {
			grid-template-columns: minmax(10rem, 13.5rem) 1fr;
			gap: 2rem;
			align-items: start;
		}
	}

	.about__portrait {
		margin: 0;
		justify-self: center;
		width: min(100%, 14rem);
	}

	@media (min-width: 640px) {
		.about__portrait {
			width: 100%;
			justify-self: stretch;
		}
	}

	.about__portrait-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--color-global-text) 5%, transparent);
	}

	.about__name {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.about__role {
		margin: 0.35rem 0 0;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--color-accent);
	}

	.about__label {
		margin: 0 0 0.7rem;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.5;
		font-weight: 700;
	}

	.about__info {
		margin-top: 1.15rem;
	}

	.about__facts {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem 1rem;
	}

	.about__fact {
		margin: 0;
		min-width: 0;
	}

	.about__fact dt {
		margin: 0;
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.42;
		font-weight: 700;
	}

	.about__fact dd {
		margin: 0.28rem 0 0;
		font-size: 0.86rem;
		line-height: 1.4;
		opacity: 0.88;
	}

	.about__bio {
		margin-top: 1.6rem;
		display: grid;
		gap: 0.7rem;
		max-width: 42rem;
		font-size: 0.92rem;
		line-height: 1.75;
		opacity: 0.88;
	}

	.about__bio p {
		margin: 0;
	}

	.about__friends {
		width: 100%;
		margin-top: 2rem;
		padding-top: 1.6rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 12%, transparent);
	}

	.about__friends .about__label {
		text-align: center;
	}

	.about__links {
		list-style: none;
		margin: 0 auto;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
	}

	.about__links > li {
		flex: 1 1 calc(50% - 0.3rem);
		max-width: 16rem;
	}

	@media (min-width: 720px) {
		.about__links > li {
			flex: 0 1 13.5rem;
			max-width: 14.5rem;
		}
	}

	.about__link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		min-height: 2.85rem;
		padding: 0.5rem 0.7rem;
		border-radius: 0.8rem;
		border: 1px solid color-mix(in oklch, var(--color-global-text) 16%, transparent);
		background: color-mix(in oklch, var(--color-global-text) 3%, transparent);
		color: inherit;
		text-decoration: none;
		font-size: 0.82rem;
		font-weight: 600;
		box-sizing: border-box;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease;
	}

	.about__link:hover {
		border-color: color-mix(in oklch, var(--color-accent) 50%, transparent);
		background: color-mix(in oklch, var(--color-accent) 8%, transparent);
		color: var(--color-accent);
	}

	.about__link:active {
		transform: scale(0.98);
	}

	.about__link-icon {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
	}

	@media (max-width: 639px) {
		.about__link {
			min-height: 3rem;
			font-size: 0.84rem;
		}
	}
</style>
