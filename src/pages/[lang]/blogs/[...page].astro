---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import FloatingBack from "@/components/FloatingBack.astro";
import PageHeader from "@/components/PageHeader.astro";
import BlogPreview from "@/components/blog/BlogPreview.astro";
import { getAllBlogs, getNamedSeries, groupBlogsByYear } from "@/data/blog";
import { pageLead } from "@/data/page-copy";
import { languages, type Lang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async () => {
	return languages.map((lang) => ({
		params: { lang, page: undefined },
	}));
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const allPostsByDate = (await getAllBlogs()).sort(collectionDateSort);
const seriesNames = getNamedSeries(allPostsByDate);
const groupedByYear = groupBlogsByYear(allPostsByDate);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const postsBySeries = new Map<string, CollectionEntry<"blog">[]>();
for (const name of seriesNames) {
	postsBySeries.set(
		name,
		allPostsByDate.filter((post) => post.data.series.includes(name)),
	);
}

const meta = {
	description: t("blogs.description"),
	title: t("blogs.title"),
};
---

<PageLayout lang={lang} meta={meta}>
	<PageHeader title={t("blogs.title")} lead={pageLead("blogs", lang, t("blogs.lead"))}>
		<a class="text-accent" href={localePath(lang, "/rss.xml")} target="_blank">
			<span class="sr-only">{t("rss.label")}</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</PageHeader>
	<div class="blogs-board" data-series="all">
		<div class="blogs-list">
			{
				descYearKeys.length === 0 && (
					<p class="text-muted mb-8" data-panel="all">{t("blogs.empty")}</p>
				)
			}
			<div data-panel="all">
				{
					descYearKeys.map((yearKey) => (
						<section class="mb-16">
							<h2 id={`year-${yearKey}`} class="title text-lg">
								<span class="sr-only">{t("blogs.year")}</span>
								{yearKey}
							</h2>
							<ul class="mt-5 space-y-4 text-start">
								{groupedByYear[yearKey]?.map((p) => (
									<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
										<BlogPreview post={p} lang={lang} omitYear />
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
			{
				seriesNames.map((name) => (
					<div data-panel={name} hidden>
						<h2 class="title mb-6 text-lg">{name}</h2>
						<ul class="mt-5 space-y-4 text-start">
							{postsBySeries.get(name)?.map((p) => (
								<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
									<BlogPreview post={p} lang={lang} />
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		{
			seriesNames.length > 0 && (
				<aside class="series-nav" aria-label={t("blogs.series")}>
					<h2 class="title mb-4 text-lg">{t("blogs.series")}</h2>
					<ul class="series-nav__list" role="list">
						<li>
							<button
								type="button"
								class="series-nav__btn"
								data-series="all"
								aria-pressed="true"
							>
								{t("blogs.all")}
							</button>
						</li>
						{seriesNames.map((name) => (
							<li>
								<button
									type="button"
									class="series-nav__btn"
									data-series={name}
									aria-pressed="false"
								>
									{name}
								</button>
							</li>
						))}
					</ul>
				</aside>
			)
		}
	</div>
	<FloatingBack />
</PageLayout>

<script>
	const board = document.querySelector(".blogs-board");
	if (board) {
		const buttons = board.querySelectorAll<HTMLButtonElement>(".series-nav__btn");
		const setSeries = (series: string) => {
			const next = series || "all";
			board.setAttribute("data-series", next);
			buttons.forEach((btn) => {
				btn.setAttribute("aria-pressed", String(btn.dataset.series === next));
			});
			board.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
				panel.hidden = panel.dataset.panel !== next;
			});
			const url = new URL(window.location.href);
			if (next === "all") url.searchParams.delete("series");
			else url.searchParams.set("series", next);
			history.replaceState(null, "", url);
		};
		buttons.forEach((btn) => {
			btn.addEventListener("click", () => setSeries(btn.dataset.series || "all"));
		});
		const initial = new URLSearchParams(window.location.search).get("series");
		const known = initial && [...buttons].some((btn) => btn.dataset.series === initial);
		if (known && initial) setSeries(initial);
	}
</script>

<style>
	.blogs-board {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.series-nav {
		order: -1;
	}

	.series-nav__list {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		gap: 0.35rem 0.85rem;
		margin: 0;
		padding: 0;
		overflow-x: auto;
		list-style: none;
		scrollbar-width: none;
	}

	.series-nav__list::-webkit-scrollbar {
		display: none;
	}

	.series-nav__btn {
		padding: 0.2rem 0.05rem 0.3rem;
		border: none;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		font: inherit;
		font-weight: 700;
		white-space: nowrap;
	}

	.series-nav__btn[aria-pressed="true"] {
		color: var(--color-brand);
		box-shadow: inset 0 -2px 0 var(--color-brand);
	}

	@media (min-width: 640px) {
		.blogs-board {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 11.5rem;
			align-items: start;
			gap: 2.5rem 3rem;
		}

		.series-nav {
			order: 0;
			position: sticky;
			top: 1.5rem;
		}

		.series-nav__list {
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 0.35rem;
			overflow: visible;
		}

		.series-nav__btn {
			display: inline;
			width: auto;
			padding: 0.35rem 0.05rem;
			text-align: start;
		}
	}
</style>
