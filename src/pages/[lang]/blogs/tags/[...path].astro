---
import type { GetStaticPaths } from "astro";
import { getAllBlogs, getUniqueTags } from "@/data/blog";
import { languages, type Lang } from "@/i18n/config";
import { localePath } from "@/i18n/utils";

export const getStaticPaths = (async () => {
	const uniqueTags = getUniqueTags(await getAllBlogs());
	return languages.flatMap((lang) =>
		uniqueTags.map((tag) => ({ params: { lang, path: tag } })),
	);
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
return Astro.redirect(localePath(lang, "/blogs/"), 301);
---
