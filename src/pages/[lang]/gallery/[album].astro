---
import PhotoFigure from "@/components/gallery/PhotoFigure.astro";
import FloatingBack from "@/components/FloatingBack.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getPhotoAlbum, getPhotoAlbums, packAlbumRows } from "@/data/gallery";
import { languages, type Lang } from "@/i18n/config";
import { localePath, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return languages.flatMap((lang) =>
		getPhotoAlbums().map((album) => ({
			params: { lang, album: album.slug },
		})),
	);
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const album = getPhotoAlbum(Astro.params.album as string)!;

const meta = {
	title: `${album.title} · ${t("gallery.title")}`,
	description: album.title,
};

const rows = packAlbumRows(album.photos);

function photoSizes(kind: "pair" | "wide" | "tile") {
	if (kind === "wide") return "(max-width: 700px) 100vw, 900px";
	return "(max-width: 700px) 100vw, 50vw";
}
---

<PageLayout lang={lang} meta={meta}>
	<section class="album-page">
		<p class="crumb">
			<a href={localePath(lang, "/gallery/")}>{t("gallery.back")}</a>
			<span aria-hidden="true"> / </span>
			<span>{album.title}</span>
		</p>
		<PageHeader
			title={album.title}
			lead={t("gallery.count", { n: album.photos.length })}
		/>
		{
			rows ? (
				<div class="album-rows">
					{rows.map((row) => (
						<div class:list={["album-row", `album-row--${row.kind}`]}>
							{row.photos.map((image) => (
								<PhotoFigure image={image} sizes={photoSizes(row.kind)} />
							))}
						</div>
					))}
				</div>
			) : (
				<ul class="album-masonry" role="list">
					{album.photos.map((image) => (
						<li>
							<PhotoFigure image={image} sizes="(max-width: 700px) 100vw, 50vw" />
						</li>
					))}
				</ul>
			)
		}
	</section>
	<FloatingBack />
</PageLayout>

<style>
	.crumb {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	.crumb a {
		color: var(--color-brand);
		text-decoration: none;
	}

	.album-rows {
		display: grid;
		gap: 0.85rem;
	}

	.album-row--pair,
	.album-row--wide,
	.album-row--tile {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
		align-items: start;
	}

	.album-masonry {
		margin: 0;
		padding: 0;
		list-style: none;
		column-count: 1;
		column-gap: 0.85rem;
	}

	.album-masonry li {
		display: inline-block;
		width: 100%;
		margin: 0 0 0.85rem;
		break-inside: avoid;
		page-break-inside: avoid;
		-webkit-column-break-inside: avoid;
	}

	@media (min-width: 700px) {
		.album-rows {
			gap: 1.15rem;
		}

		.album-row--pair {
			grid-template-columns: 1fr 1fr;
			gap: 1.15rem;
		}

		.album-row--tile {
			grid-template-columns: 1fr 1fr;
		}

		.album-row--tile > :only-child {
			grid-column: 1;
		}

		.album-masonry {
			column-count: 2;
			column-gap: 1.15rem;
		}

		.album-masonry li {
			margin-bottom: 1.15rem;
		}
	}
</style>
