---
import FloatingBack from "@/components/FloatingBack.astro";
import { buildPhotoSrcSet, getPhotoAlbums, photoThumbUrl } from "@/data/photos";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import type { Lang } from "@/i18n/config";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const albums = getPhotoAlbums();
const PREVIEW = 5;

const meta = {
	title: t("photos.title"),
	description: t("photos.description"),
};
---

<PageLayout lang={lang} meta={meta}>
	<section class="gallery-page">
		<h1 class="title mb-2">{t("photos.title")}</h1>
		<p class="intro">{t("photos.intro")}</p>

		{
			albums.length === 0 ? (
				<p class="empty">{t("photos.empty")}</p>
			) : (
				albums.map((album) => {
					const preview = album.photos.slice(0, PREVIEW);
					return (
						<a class="set" href={localePath(lang, `/gallery/${album.slug}/`)}>
							<header class="set__head">
								<h2 class="set__title">{album.title}</h2>
								<span class="set__meta">
									{t("photos.viewAll")} · {t("photos.count", { n: album.photos.length })}
								</span>
							</header>
							<div class="set__preview">
								{preview.map((image) => {
									const thumb = photoThumbUrl(image.src, 600);
									const srcset = buildPhotoSrcSet(image.src, [400, 600, 900]);
									return (
										<span class="set__thumb">
											<img
												src={thumb}
												srcset={srcset}
												sizes="(max-width: 860px) 32vw, 180px"
												alt=""
												loading="lazy"
												decoding="async"
												width="400"
												height="400"
											/>
										</span>
									);
								})}
							</div>
						</a>
					);
				})
			)
		}
	</section>
	<FloatingBack />
</PageLayout>

<style>
	.intro {
		margin-bottom: 2.25rem;
		opacity: 0.7;
		font-size: 0.95rem;
	}

	.empty {
		opacity: 0.75;
	}

	.set {
		display: block;
		margin-bottom: 2.5rem;
		color: inherit;
		text-decoration: none;
	}

	.set__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1rem;
		margin-bottom: 0.9rem;
	}

	.set__title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
	}

	.set__meta {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-brand);
	}

	.set__preview {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}

	.set__preview > :nth-child(n + 4) {
		display: none;
	}

	.set__thumb {
		display: block;
		overflow: hidden;
		aspect-ratio: 1;
		border-radius: 0.7rem;
		background: color-mix(in oklch, var(--color-global-text) 6%, transparent);
	}

	.set__thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.set:hover .set__title {
		color: var(--color-brand);
	}

	@media (min-width: 860px) {
		.set__preview {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 10px;
		}

		.set__preview > :nth-child(n + 4) {
			display: block;
		}
	}
</style>
