---
import FormattedDate from "@/components/FormattedDate.astro";
import Note from "@/components/note/Note.astro";
import PageLayout from "@/layouts/Base.astro";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import { getAllNotes } from "@/data/note";
import { getAllPosts } from "@/data/post";
import { siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const RECENT_POSTS = 3;
const RECENT_NOTES = 3;

const recentPosts = (await getAllPosts())
	.filter((post) => !post.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_POSTS);

const recentNotes = (await getAllNotes())
	.filter((note) => !note.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_NOTES);
---

<PageLayout
	lang={lang}
	wide
	meta={{ title: t("home.title"), description: t("site.description") }}
>
	<div class="home-stage">
		<section class="foyer">
			<div class="foyer-copy">
				<h1 class="title foyer-title">{siteConfig.title}</h1>
				<p class="foyer-tagline">{t("home.tagline")}</p>
			</div>
			<figure class="foyer-hero">
				<img
					alt={t("home.heroAlt")}
					class="foyer-hero__img"
					height="777"
					src="/home-hero.jpg"
					width="1240"
				/>
			</figure>
		</section>

		<section class="home-feed home-feed--notes" aria-labelledby="home-notes-heading">
			<h2 id="home-notes-heading" class="home-heading">{t("home.recentNotes")}</h2>
			{
				recentNotes.length === 0 ? (
					<p class="home-empty">{t("notes.empty")}</p>
				) : (
					<ul class="home-notes" role="list">
						{recentNotes.map((note) => (
							<li>
								<Note note={note} as="h3" lang={lang} plain />
							</li>
						))}
					</ul>
				)
			}
			<a class="home-more" href={localePath(lang, "/notes/")}>
				{t("home.viewAllNotes")}
				<span aria-hidden="true">→</span>
			</a>
		</section>

		<section class="home-feed home-feed--posts" aria-labelledby="home-posts-heading">
			<h2 id="home-posts-heading" class="home-heading">{t("home.recentPosts")}</h2>
			{
				recentPosts.length === 0 ? (
					<p class="home-empty">{t("posts.empty")}</p>
				) : (
					<ul class="home-posts" role="list">
						{recentPosts.map((post) => (
							<li>
								<article class="home-post">
									<a class="home-post__hit" href={localePath(lang, `/posts/${post.id}/`)}>
										<span class="home-post__title">{post.data.title}</span>
										<FormattedDate
											class="home-post__date"
											date={post.data.publishDate}
											lang={lang}
										/>
									</a>
									{
										post.data.tags.length > 0 && (
											<ul class="home-post__tags" role="list">
												{post.data.tags.map((tag) => (
													<li>
														<a class="home-post__tag" href={localePath(lang, `/tags/${tag}/`)}>
															#{tag}
														</a>
													</li>
												))}
											</ul>
										)
									}
								</article>
							</li>
						))}
					</ul>
				)
			}
			<a class="home-more" href={localePath(lang, "/posts/")}>
				{t("home.viewAllPosts")}
				<span aria-hidden="true">→</span>
			</a>
		</section>
	</div>
</PageLayout>

<style>
	.home-stage {
		display: flex;
		flex-direction: column;
		padding-bottom: 2rem;
	}

	.foyer {
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - 9.25rem);
		padding: 0 0 1.5rem;
	}

	.foyer-copy {
		flex-shrink: 0;
	}

	.foyer-title {
		margin-bottom: 0.4rem;
		font-size: clamp(1.85rem, 5vw, 2.5rem);
		line-height: 1.15;
	}

	.foyer-tagline {
		margin: 0 0 1rem;
		max-width: 22rem;
		font-size: 1.05rem;
		line-height: 1.7;
		opacity: 0.78;
	}

	.foyer-hero {
		position: relative;
		flex: 1 1 auto;
		min-height: 16rem;
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--color-brand) 12%, var(--color-global-bg));
		box-shadow: 0 18px 40px color-mix(in oklch, var(--color-brand) 16%, transparent);
	}

	.foyer-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(
				180deg,
				transparent 42%,
				color-mix(in oklch, var(--color-brand) 28%, transparent) 100%
			),
			linear-gradient(
				90deg,
				color-mix(in oklch, var(--color-brand) 10%, transparent),
				transparent 40%
			);
		pointer-events: none;
		mix-blend-mode: multiply;
	}

	.foyer-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform-origin: 40% 40%;
		animation: kitchen-hero-drift 22s ease-in-out infinite alternate;
		filter: saturate(1.08) contrast(1.05);
	}

	.home-feed {
		padding-top: 1.75rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 10%, transparent);
	}

	.home-heading {
		margin: 0 0 1.15rem;
		padding-bottom: 0.7rem;
		border-bottom: 1px solid color-mix(in oklch, var(--color-brand) 22%, transparent);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--color-accent-2);
	}

	.home-empty {
		margin: 0 0 0.75rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.home-notes {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-notes > li + li {
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 8%, transparent);
	}

	.home-notes :global(.note-card__body img) {
		max-height: 13rem;
		object-fit: cover;
	}

	.home-posts {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.home-post {
		padding: 0.95rem 1rem 1rem;
		border-radius: 0.9rem;
		background: var(--color-global-bg);
		border: 1px solid color-mix(in oklch, var(--color-global-text) 7%, transparent);
		box-shadow: 0 8px 22px color-mix(in oklch, var(--color-global-text) 7%, transparent);
		transition:
			transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.2s ease;
	}

	.home-post:hover,
	.home-post:active {
		transform: translateY(-2px);
		box-shadow: 0 12px 28px color-mix(in oklch, var(--color-brand) 16%, transparent);
	}

	.home-post__hit {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.28rem;
		color: inherit;
		text-decoration: none;
	}

	.home-post__title {
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.home-post__hit:hover .home-post__title {
		color: var(--color-brand);
	}

	.home-post__date {
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.home-post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.65rem;
		margin: 0.45rem 0 0;
		padding: 0;
		list-style: none;
	}

	.home-post__tag {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
		opacity: 0.88;
	}

	.home-post__tag:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (min-width: 1024px) {
		.home-stage {
			display: grid;
			grid-template-columns: minmax(16rem, 0.95fr) minmax(22rem, 1.25fr) minmax(15rem, 0.9fr);
			grid-template-areas: "notes hero posts";
			align-items: start;
			gap: 2rem 2.25rem;
			padding-top: 0.25rem;
		}

		.foyer {
			grid-area: hero;
			min-height: 0;
			padding: 0;
			position: sticky;
			top: 1.25rem;
		}

		.home-feed--notes {
			grid-area: notes;
		}

		.home-feed--posts {
			grid-area: posts;
		}

		.home-feed {
			padding-top: 0;
			border-top: none;
		}

		.foyer-hero {
			flex: none;
			min-height: 22rem;
			aspect-ratio: 4 / 5;
			max-height: min(38rem, 72vh);
		}

		.home-notes :global(.note-card__body img) {
			max-height: 9.5rem;
		}

		.home-heading {
			font-size: 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foyer-hero__img {
			animation: none;
		}

		.home-post:hover,
		.home-post:active {
			transform: none;
		}
	}
</style>
