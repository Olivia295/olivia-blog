---
import FormattedDate from "@/components/FormattedDate.astro";
import Note from "@/components/note/Note.astro";
import PageLayout from "@/layouts/Base.astro";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import { getAllNotes } from "@/data/note";
import { getAllPosts } from "@/data/post";
import { siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const RECENT_POSTS = 3;
const RECENT_NOTES = 3;

const recentPosts = (await getAllPosts())
	.filter((post) => !post.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_POSTS);

const recentNotes = (await getAllNotes())
	.filter((note) => !note.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_NOTES);
---

<PageLayout lang={lang} meta={{ title: t("home.title"), description: t("site.description") }}>
	<section class="foyer">
		<h1 class="title foyer-title">{siteConfig.title}</h1>
		<p class="foyer-tagline">{t("home.tagline")}</p>
		<figure class="foyer-hero">
			<img
				alt={t("home.heroAlt")}
				class="foyer-hero__img"
				height="777"
				src="/home-hero.jpg"
				width="1240"
			/>
		</figure>
	</section>

	<section class="home-feed" aria-labelledby="home-notes-heading">
		<h2 id="home-notes-heading" class="home-heading">{t("home.recentNotes")}</h2>
		{
			recentNotes.length === 0 ? (
				<p class="home-empty">{t("notes.empty")}</p>
			) : (
				<ul class="home-notes" role="list">
					{recentNotes.map((note) => (
						<li>
							<Note note={note} as="h3" lang={lang} plain />
						</li>
					))}
				</ul>
			)
		}
		<a class="home-more" href={localePath(lang, "/notes/")}>
			{t("home.viewAllNotes")}
			<span aria-hidden="true">→</span>
		</a>
	</section>

	<section class="home-feed home-feed--posts" aria-labelledby="home-posts-heading">
		<h2 id="home-posts-heading" class="home-heading">{t("home.recentPosts")}</h2>
		{
			recentPosts.length === 0 ? (
				<p class="home-empty">{t("posts.empty")}</p>
			) : (
				<ul class="home-posts" role="list">
					{recentPosts.map((post) => (
						<li class="home-post">
							<a class="home-post__title" href={localePath(lang, `/posts/${post.id}/`)}>
								{post.data.title}
							</a>
							<FormattedDate class="home-post__date" date={post.data.publishDate} lang={lang} />
							{
								post.data.tags.length > 0 && (
									<ul class="home-post__tags" role="list">
										{post.data.tags.map((tag) => (
											<li>
												<a class="home-post__tag" href={localePath(lang, `/tags/${tag}/`)}>
													#{tag}
												</a>
											</li>
										))}
									</ul>
								)
							}
						</li>
					))}
				</ul>
			)
		}
		<a class="home-more" href={localePath(lang, "/posts/")}>
			{t("home.viewAllPosts")}
			<span aria-hidden="true">→</span>
		</a>
	</section>
</PageLayout>

<style>
	.foyer {
		padding: 0.35rem 0 0.15rem;
	}

	.foyer-title {
		margin-bottom: 0.4rem;
		font-size: clamp(1.85rem, 5vw, 2.5rem);
		line-height: 1.15;
	}

	.foyer-tagline {
		margin: 0 0 1.1rem;
		max-width: 22rem;
		font-size: 1.05rem;
		line-height: 1.7;
		opacity: 0.78;
	}

	.foyer-hero {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--color-brand) 12%, var(--color-global-bg));
		box-shadow: 0 18px 40px color-mix(in oklch, var(--color-brand) 16%, transparent);
	}

	.foyer-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				transparent 42%,
				color-mix(in oklch, var(--color-brand) 28%, transparent) 100%
			),
			linear-gradient(
				90deg,
				color-mix(in oklch, var(--color-brand) 10%, transparent),
				transparent 40%
			);
		pointer-events: none;
		mix-blend-mode: multiply;
	}

	.foyer-hero__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transform-origin: 40% 40%;
		animation: kitchen-hero-drift 22s ease-in-out infinite alternate;
		filter: saturate(1.08) contrast(1.05);
	}

	.home-feed {
		margin-top: 2rem;
		padding-bottom: 0.5rem;
	}

	.home-feed--posts {
		margin-top: 2.25rem;
		padding-bottom: 2rem;
	}

	.home-heading {
		margin: 0 0 1.1rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.home-empty {
		margin: 0 0 0.75rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.home-notes {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-notes > li + li {
		margin-top: 1.35rem;
		padding-top: 1.35rem;
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 8%, transparent);
	}

	.home-posts {
		margin: 0 0 0.85rem;
		padding: 0;
		list-style: none;
	}

	.home-post {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		padding: 0.95rem 0;
	}

	.home-post + .home-post {
		border-top: 1px solid color-mix(in oklch, var(--color-global-text) 8%, transparent);
	}

	.home-post__title {
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
		color: inherit;
		text-decoration: none;
	}

	.home-post__title:hover,
	.home-post__title:active {
		color: var(--color-brand);
	}

	.home-post__date {
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.home-post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.7rem;
		margin: 0.2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.home-post__tag {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
		opacity: 0.85;
	}

	.home-post__tag:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (min-width: 640px) {
		.foyer {
			padding: 0.6rem 0 0.25rem;
		}

		.home-feed {
			margin-top: 2.5rem;
		}

		.home-feed--posts {
			margin-top: 2.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foyer-hero__img {
			animation: none;
		}
	}
</style>
