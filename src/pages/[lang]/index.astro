---
import FormattedDate from "@/components/FormattedDate.astro";
import PageLayout from "@/layouts/Base.astro";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import { getAllNotes } from "@/data/note";
import { getAllPosts } from "@/data/post";
import { siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const RECENT_POSTS = 3;
const RECENT_NOTES = 3;

const recentPosts = (await getAllPosts())
	.filter((post) => !post.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_POSTS);

const recentNotes = (await getAllNotes())
	.filter((note) => !note.data.draft)
	.sort(collectionDateSort)
	.slice(0, RECENT_NOTES);
---

<PageLayout lang={lang} meta={{ title: t("home.title"), description: t("site.description") }}>
	<section class="foyer">
		<h1 class="title foyer-title">{siteConfig.title}</h1>
		<p class="foyer-tagline">{t("home.tagline")}</p>
		<figure class="foyer-hero">
			<img
				alt={t("home.heroAlt")}
				class="foyer-hero__img"
				height="777"
				src="/home-hero.jpg"
				width="1240"
			/>
		</figure>
	</section>

	<section class="home-feed">
		<details class="home-fold" open>
			<summary class="home-fold__summary">{t("home.recentPosts")}</summary>
			{
				recentPosts.length === 0 ? (
					<p class="home-fold__empty">{t("posts.empty")}</p>
				) : (
					<ul class="home-fold__list">
						{recentPosts.map((post) => (
							<li>
								<a class="home-fold__link" href={localePath(lang, `/posts/${post.id}/`)}>
									<span class="home-fold__title">{post.data.title}</span>
									<FormattedDate class="home-fold__date" date={post.data.publishDate} lang={lang} />
								</a>
							</li>
						))}
					</ul>
				)
			}
			<a class="home-fold__more" href={localePath(lang, "/posts/")}>
				{t("home.viewAllPosts")}
				<span aria-hidden="true">→</span>
			</a>
		</details>

		<details class="home-fold" open>
			<summary class="home-fold__summary">{t("home.recentNotes")}</summary>
			{
				recentNotes.length === 0 ? (
					<p class="home-fold__empty">{t("notes.empty")}</p>
				) : (
					<ul class="home-fold__list">
						{recentNotes.map((note) => (
							<li>
								<a class="home-fold__link" href={`${localePath(lang, "/notes/")}#note-${note.id}`}>
									<span class="home-fold__title">{note.data.title}</span>
									<FormattedDate class="home-fold__date" date={note.data.publishDate} lang={lang} />
								</a>
							</li>
						))}
					</ul>
				)
			}
			<a class="home-fold__more" href={localePath(lang, "/notes/")}>
				{t("home.viewAllNotes")}
				<span aria-hidden="true">→</span>
			</a>
		</details>
	</section>
</PageLayout>

<style>
	.foyer {
		padding: 0.35rem 0 0.15rem;
	}

	.foyer-title {
		margin-bottom: 0.4rem;
		font-size: clamp(1.85rem, 5vw, 2.5rem);
		line-height: 1.15;
	}

	.foyer-tagline {
		margin: 0 0 1.1rem;
		max-width: 22rem;
		font-size: 1.05rem;
		line-height: 1.7;
		opacity: 0.78;
	}

	.foyer-hero {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: 1rem;
		background: color-mix(in oklch, var(--color-brand) 12%, var(--color-global-bg));
		box-shadow:
			0 18px 40px color-mix(in oklch, var(--color-brand) 18%, transparent),
			0 0 0 1px color-mix(in oklch, var(--color-brand) 14%, transparent);
	}

	.foyer-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				transparent 42%,
				color-mix(in oklch, var(--color-brand) 28%, transparent) 100%
			),
			linear-gradient(
				90deg,
				color-mix(in oklch, var(--color-brand) 10%, transparent),
				transparent 40%
			);
		pointer-events: none;
		mix-blend-mode: multiply;
	}

	.foyer-hero__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transform-origin: 40% 40%;
		animation: kitchen-hero-drift 22s ease-in-out infinite alternate;
		filter: saturate(1.08) contrast(1.05);
	}

	.home-feed {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		margin-top: 1.35rem;
		padding-bottom: 1.75rem;
	}

	@media (min-width: 640px) {
		.foyer {
			padding: 0.6rem 0 0.25rem;
		}

		.home-feed {
			margin-top: 1.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foyer-hero__img {
			animation: none;
		}
	}
</style>
