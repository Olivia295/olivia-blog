---
import SkinSlot from "@/skins/SkinSlot.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getAllBlogs } from "@/data/blog";
import { notePreview } from "@/data/note-preview";
import { getAllPosts } from "@/data/post";
import { resolvePostTags } from "@/data/post-tags";
import { profile } from "@/data/profile";
import { settings } from "@/data/settings";
import { publicImageSize, siteHeroSrc } from "@/data/site-assets";
import { seriesHref, seriesLabel } from "@/data/site-series";
import { contentDate, sortTimeline } from "@/data/timeline";
import type { Lang } from "@/i18n/config";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
export function getStaticPaths() {
	return getStaticLangPaths();
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const blogs = sortTimeline(
	(await getAllBlogs())
		.filter((e) => !e.data.draft)
		.map((blog) => ({ key: blog.id, date: contentDate(blog.data.publishDate), blog })),
).slice(0, settings.home.articles);
const posts = sortTimeline(
	(await getAllPosts())
		.filter((e) => !e.data.draft)
		.map((post) => ({ key: post.id, date: contentDate(post.data.publishDate), post })),
).slice(0, settings.home.notes);
const notes = await Promise.all(
	posts.map(async (entry) => ({
		...entry,
		preview: await notePreview(entry.post.body ?? "", entry.post.id),
	})),
);
const portraitSize = await publicImageSize(siteHeroSrc);
const heroAlt =
	settings.home.portraitAlt[lang] ||
	(siteHeroSrc === "/defaults/portrait.svg"
		? lang === "zh"
			? "小小飞船的窗景插画"
			: "An illustrated spaceship window"
		: lang === "zh"
			? `${profile.name} 的个人图片`
			: `A personal picture of ${profile.name}`);
const showNotes = settings.sections.posts && (!settings.sections.hideEmpty || notes.length > 0);
const showBlogs = settings.sections.blogs && (!settings.sections.hideEmpty || blogs.length > 0);
const empty =
	lang === "zh"
		? "这里还很安静，新的分享会慢慢到来。"
		: "It’s quiet here. New stories will arrive in time.";
---

<PageLayout home lang={lang} meta={{ title: t("home.title"), description: siteConfig.description }}>
	<section class="ship-window" aria-labelledby="home-name">
		<SkinSlot position="home-background" lang={lang} />
		<div class="foyer-copy">
			<SkinSlot position="home-eyebrow" lang={lang} />
			<h1 id="home-name">
				{lang === "zh" ? "你好，我是" : "Hello, I’m"}<br />{profile.name}<span aria-hidden="true"
					>.</span
				>
			</h1>
			<p>{settings.intro[lang]}</p>
			{
				settings.sections.about && (
					<a class="welcome-link" href={localePath(lang, "/about/")}>
						{lang === "zh" ? "很高兴你来做客" : "Make yourself at home"}{" "}
						<span aria-hidden="true">↗</span>
					</a>
				)
			}
		</div>
		<figure class="hero-portrait">
			<img
				src={siteHeroSrc}
				width={portraitSize?.width}
				height={portraitSize?.height}
				alt={heroAlt}
				fetchpriority="high"
				decoding="async"
			/>
		</figure>
		<SkinSlot position="home-status" lang={lang} />
	</section>
	<section
		class="recent-columns"
		id="recent-heading"
		aria-label={lang === "zh" ? "最近的分享" : "Recent sharing"}
	>
		{
			showNotes && (
				<section class="recent-column recent-notes" aria-labelledby="notes-heading">
					<div class="section-heading">
						<>
							<h2 id="notes-heading">{lang === "zh" ? "最近短记" : "Recent notes"}</h2>
							<span>MOMENTS / 01</span>
						</>
					</div>
					{notes.length ? (
						<ol class="recent-list" role="list">
							{notes.map(({ post, date, preview }) => (
								<li class="log-entry note-preview" data-kind="post" data-date={date?.toISOString()}>
									<article class="note-card--preview">
										<div class="preview-tags">
											{resolvePostTags(post.data.tags, lang)
												.slice(0, 2)
												.map((tag) => (
													<span>{tag.label}</span>
												))}
										</div>
										<p class="note-preview-text">
											{preview.text ||
												(lang === "zh" ? "用照片记下的片刻。" : "A moment in photographs.")}
										</p>
										{preview.photos.length > 0 && (
											<div class="preview-photo-row">
												<a
													class="preview-photo"
													href={preview.photos[0]!.src}
													data-photo-src={preview.photos[0]!.src}
													data-photo-alt={preview.photos[0]!.alt}
													aria-label={
														lang === "zh"
															? `查看短记照片，共 ${preview.photos.length} 张`
															: `View note photo, ${preview.photos.length} in total`
													}
												>
													<img
														src={preview.photos[0]!.src}
														alt={preview.photos[0]!.alt}
														width="96"
														height="96"
														loading="lazy"
													/>
												</a>
												<a class="photo-count" href={localePath(lang, `/posts/#post-${post.id}`)}>
													{lang === "zh"
														? `${preview.photos.length} 张照片`
														: `${preview.photos.length} photos`}{" "}
													<span aria-hidden="true">↗</span>
												</a>
											</div>
										)}
										<div class="preview-meta">
											<FormattedDate date={post.data.publishDate} lang={lang} />
											<a class="preview-detail" href={localePath(lang, `/posts/#post-${post.id}`)}>
												{lang === "zh" ? "阅读短记" : "Read note"} <span aria-hidden="true">↗</span>
											</a>
										</div>
									</article>
								</li>
							))}
						</ol>
					) : (
						<p class="recent-empty">{empty}</p>
					)}
					<a class="home-more" href={localePath(lang, "/posts/")}>
						{lang === "zh" ? "全部短记" : "All notes"} →
					</a>
				</section>
			)
		}
		{
			showBlogs && (
				<section class="recent-column recent-articles" aria-labelledby="articles-heading">
					<div class="section-heading">
						<>
							<h2 id="articles-heading">{lang === "zh" ? "最近文章" : "Recent writing"}</h2>
							<span>WRITING / 02</span>
						</>
					</div>
					{blogs.length ? (
						<ol class="recent-list" role="list">
							{blogs.map(({ blog, date }) => (
								<li
									class="log-entry article-preview"
									data-kind="blog"
									data-date={date?.toISOString()}
								>
									<article>
										<h3>
											<a href={localePath(lang, `/blogs/${blog.id}/`)}>
												{blog.data.title} <span aria-hidden="true">↗</span>
											</a>
										</h3>
										<FormattedDate date={blog.data.publishDate} lang={lang} />
										<div class="preview-tags">
											{blog.data.series.slice(0, 3).map((name) => (
												<a href={seriesHref(name, lang)}>{seriesLabel(name, lang)}</a>
											))}
											{blog.data.series.length > 3 && (
												<span
													aria-label={
														lang === "zh"
															? `还有 ${blog.data.series.length - 3} 个系列`
															: `${blog.data.series.length - 3} more series`
													}
												>
													+{blog.data.series.length - 3}
												</span>
											)}
										</div>
									</article>
								</li>
							))}
						</ol>
					) : (
						<p class="recent-empty">{empty}</p>
					)}
					<a class="home-more" href={localePath(lang, "/blogs/")}>
						{lang === "zh" ? "全部文章" : "All writing"} →
					</a>
				</section>
			)
		}
		{!showBlogs && !showNotes && <p class="recent-empty">{empty}</p>}
	</section>
	<SkinSlot position="home-controls" lang={lang} />
</PageLayout>
