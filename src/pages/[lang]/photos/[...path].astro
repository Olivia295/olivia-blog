---
import { getPhotoAlbums } from "@/data/gallery";
import { languages } from "@/i18n/config";

export function getStaticPaths() {
	const albums = getPhotoAlbums();
	return languages.flatMap((lang) => [
		{ params: { lang, path: undefined }, redirect: `/${lang}/gallery/` },
		...albums.flatMap((album) => {
			const dest = encodeURI(`/${lang}/gallery/${album.slug}/`);
			return [
				{ params: { lang, path: album.slug }, redirect: dest },
				...album.photos.map((photo) => ({
					params: { lang, path: `${album.slug}/${photo.slug}` },
					redirect: dest,
				})),
			];
		}),
	]);
}
