---
import FloatingBack from "@/components/FloatingBack.astro";
import PageHeader from "@/components/PageHeader.astro";
import {
	buildPhotoSrcSet,
	getPhotoAlbums,
	photoThumbUrl,
} from "@/data/gallery";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import type { Lang } from "@/i18n/config";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const albums = getPhotoAlbums();

const meta = {
	title: t("gallery.title"),
	description: t("gallery.description"),
};
---

<PageLayout lang={lang} meta={meta}>
	<section class="photos-page motion-fade-up">
		<PageHeader title={t("gallery.title")} lead={t("gallery.lead")} />

		{
			albums.length === 0 ? (
				<p class="empty">{t("gallery.empty")}</p>
			) : (
				albums.map((album) => (
					<section class="collection">
						<h2>{album.title}</h2>
						<div class="photo-grid motion-stagger">
							{album.photos.map((image) => {
								const href = localePath(lang, `/photos/${album.slug}/${image.slug}/`);
								const thumb = photoThumbUrl(image.src, 600);
								const srcset = buildPhotoSrcSet(image.src, [400, 600, 900]);
								return (
									<a class="photo-item motion-press" href={href}>
										<img
											src={thumb}
											srcset={srcset}
											sizes="(max-width: 640px) 50vw, 200px"
											alt={image.alt}
											loading="lazy"
											decoding="async"
											width="400"
											height="400"
										/>
									</a>
								);
							})}
						</div>
					</section>
				))
			)
		}
	</section>
	<FloatingBack />
</PageLayout>

<style>
	.photos-page {
		width: 100%;
	}

	.empty {
		opacity: 0.75;
	}

	.collection {
		margin-bottom: 4rem;
	}

	h2 {
		margin-bottom: 1rem;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--color-accent, var(--accent));
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 14px;
	}

	.photo-item {
		display: block;
		overflow: hidden;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.05);
		cursor: zoom-in;
		transition:
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.2s ease,
			box-shadow 0.25s ease;
	}

	.photo-item:hover {
		transform: translateY(-2px);
		opacity: 0.95;
		box-shadow: 0 12px 28px color-mix(in oklch, var(--color-global-text) 12%, transparent);
	}

	.photo-item img {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		display: block;
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.photo-item:hover img {
		transform: scale(1.04);
	}

	:global(html[data-theme="dark"]) .photo-item {
		background: rgba(255, 255, 255, 0.05);
	}

	@media (max-width: 640px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 8px;
		}
		.photo-item {
			border-radius: 12px;
		}
		.intro {
			margin-bottom: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo-item,
		.photo-item img {
			transition: none;
		}
		.photo-item:hover,
		.photo-item:hover img {
			transform: none;
		}
	}
</style>
