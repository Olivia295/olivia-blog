---
import type { GetStaticPaths } from "astro";
import { getAllBlogs, getUniqueTags } from "@/data/blog";
import { languages } from "@/i18n/config";

export const getStaticPaths = (async () => {
	const uniqueTags = getUniqueTags(await getAllBlogs());
	return languages.flatMap((lang) => [
		{ params: { lang, path: undefined }, redirect: `/${lang}/blogs/` },
		...uniqueTags.map((tag) => ({
			params: { lang, path: tag },
			redirect: encodeURI(`/${lang}/blogs/`),
		})),
	]);
}) satisfies GetStaticPaths;
---
