---
import type { GetStaticPaths } from "astro";
import { legacySeriesLinks } from "@/data/site-series";
import { languages } from "@/i18n/config";
export const getStaticPaths = (async () =>
	languages.flatMap((lang) => [
		{ params: { lang, path: undefined }, props: { destination: `/${lang}/blogs/` } },
		...legacySeriesLinks().map(({ tag, id }) => ({
			params: { lang, path: tag },
			props: { destination: `/${lang}/blogs/?series=${encodeURIComponent(id)}` },
		})),
	])) satisfies GetStaticPaths;
return Astro.redirect(Astro.props.destination, 301);
---
