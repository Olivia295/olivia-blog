---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getAllPosts, getUniqueTags } from "@/data/post";
import { languages, type Lang } from "@/i18n/config";
import { localePath } from "@/i18n/utils";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return languages.flatMap((lang) =>
		uniqueTags.flatMap((tag) => {
			const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));
			return paginate(postsWithTag, {
				pageSize: 10,
				params: { lang, tag },
			});
		}),
	);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const lang = Astro.params.lang as Lang;
const { page } = Astro.props as Props;
const tag = Astro.params.tag as string;
const suffix = page.currentPage > 1 ? `${page.currentPage}/` : "";
return Astro.redirect(localePath(lang, `/posts/tags/${tag}/${suffix}`), 301);
---

