---
import FloatingBack from "@/components/FloatingBack.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import { getStaticLangPaths, localePath, useTranslations } from "@/i18n/utils";
import type { Lang } from "@/i18n/config";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: t("tags.description"),
	title: t("tags.title"),
};
---

<PageLayout lang={lang} meta={meta}>
	<h1 class="title mb-6">{t("tags.title")}</h1>
	<ul class="space-y-4">
		{
			allTags.map(([tag, val]) => (
				<li class="flex items-center gap-x-2">
					<a
						class="cactus-link inline-block"
						href={localePath(lang, `/tags/${tag}/`)}
						title={`${t("tags.view")}: ${tag}`}
					>
						&#35;{tag}
					</a>
					<span class="inline-block">
						- {val} {t("tags.count")}
					</span>
				</li>
			))
		}
	</ul>
	<FloatingBack href={localePath(lang, "/posts/")} label={t("post.back")} />
</PageLayout>
