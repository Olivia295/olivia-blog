---
/**
 * Root entry: cookie locale=en → /en/, otherwise /zh/.
 * Preview period does not use Accept-Language.
 * Static hosting: client + meta refresh (middleware needs SSR adapter).
 */
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Astro Cactus</title>
		<meta http-equiv="refresh" content="0;url=/zh/" />
		<script is:inline>
			(function () {
				function readCookie(name) {
					const m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
					return m ? decodeURIComponent(m[1]) : null;
				}
				const cookie = readCookie("locale");
				const lang = cookie === "en" ? "en" : "zh";
				location.replace("/" + lang + "/");
			})();
		</script>
	</head>
	<body>
		<p>
			<a href="/zh/">中文</a>
			·
			<a href="/en/">English</a>
		</p>
	</body>
</html>
