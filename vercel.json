{
	"cleanUrls": true,
	"trailingSlash": true,
	"redirects": [
		{ "source": "/blogs", "destination": "/zh/blogs/", "permanent": false },
		{ "source": "/blogs/:path*", "destination": "/zh/blogs/:path*", "permanent": false },
		{ "source": "/posts", "destination": "/zh/posts/", "permanent": false },
		{ "source": "/posts/:path*", "destination": "/zh/posts/:path*", "permanent": false },
		{ "source": "/notes", "destination": "/zh/posts/", "permanent": false },
		{ "source": "/notes/rss.xml", "destination": "/zh/posts/rss.xml", "permanent": false },
		{ "source": "/notes/:path*", "destination": "/zh/posts/", "permanent": false },
		{ "source": "/photos", "destination": "/zh/gallery/", "permanent": false },
		{ "source": "/photos/:album", "destination": "/zh/gallery/:album/", "permanent": false },
		{ "source": "/gallery", "destination": "/zh/gallery/", "permanent": false },
		{ "source": "/gallery/:album", "destination": "/zh/gallery/:album/", "permanent": false },
		{ "source": "/tags", "destination": "/zh/blogs/", "permanent": false },
		{ "source": "/tags/:path*", "destination": "/zh/blogs/tags/:path*", "permanent": false },
		{ "source": "/about", "destination": "/zh/about/", "permanent": false },
		{ "source": "/rss.xml", "destination": "/zh/rss.xml", "permanent": false }
	]
}
